import { Button, CheckBox, LineEdit, ComboBox, TabWidget, ListView, Palette, ScrollView, Spinner } from "std-widgets.slint";

export struct TreeRow {
    id: int,
    depth: int,
    name: string,
    size: string,
    percent: string,
    fraction: float,
    expandable: bool,
    expanded: bool,
    is-dir: bool,
    summary: bool,
    note: string,
}

export struct MapRect {
    id: int,
    x: length,
    y: length,
    width: length,
    height: length,
    color: color,
    text-color: color,
    label: string,
    nested: bool,
    /// Icon for the kind of content (see Icons.of), shown when `icon-size`
    /// isn't 0; `app-icon` replaces it when `has-app-icon`.
    icon: int,
    app-icon: image,
    has-app-icon: bool,
    icon-size: length,
    /// A tool can rebuild it: drawn with a green outline.
    ring: bool,
}

/// One circle of the bubble view. `id` is -1 for the bubble standing for
/// the smaller items; the start screen's app bubbles use `key` instead.
export struct BubbleItem {
    id: int,
    key: string,
    x: length,
    y: length,
    r: length,
    color: color,
    text-color: color,
    label: string,
    detail: string,
    /// 0 for the folder's own items, 1 for items drawn inside them.
    depth: int,
    icon: int,
    app-icon: image,
    has-app-icon: bool,
    icon-size: length,
    ring: bool,
    /// Its label sits on a dark pill, over the bubbles inside it.
    pill: bool,
}

/// An item in the basket.
export struct BasketRow {
    id: int,
    name: string,
    place: string,
    size: string,
}

/// One step of the path to the folder shown.
export struct Crumb {
    id: int,
    label: string,
}

export struct FileRow {
    id: int,
    name: string,
    folder: string,
    size: string,
    fraction: float,
}

/// One row of the scan view's Clean up tab.
export struct CleanRow {
    /// 0 section heading, 1 file or folder, 2 duplicate group label,
    /// 3 a quarantine batch (Put back and Empty).
    kind: int,
    /// Node to select, for files and folders.
    id: int,
    title: string,
    subtitle: string,
    detail: string,
    /// Button text for headings; empty for none. The batch id for a
    /// quarantine batch.
    action: string,
    /// A preview, for photos.
    has-image: bool,
    image: image,
    /// Clean up: whether it has a tick box, and whether it's ticked (in
    /// the basket). Group rows: every copy is ticked.
    checkable: bool,
    checked: bool,
    /// A short label beside the name ("Keep", "safe"); `warn` draws it,
    /// or a group's title, in the warning color.
    badge: string,
    warn: bool,
}

/// A set of similar photos, shown side by side.
export struct PhotoSet {
    /// The group's index, for its "select extras" button.
    index: int,
    title: string,
    /// Set when every photo of the set is ticked.
    warning: string,
    action: string,
    photos: [CleanRow],
}

/// A card on the Clean up tab's overview.
export struct CleanSection {
    key: string,
    title: string,
    note: string,
    /// What it could free; empty when it isn't about space.
    size: string,
    /// "3 selected", when some of it is in the basket.
    picked: string,
    /// A search, stop or other button; empty for none.
    action: string,
    has-page: bool,
    warn: bool,
}

/// One row of the Clean junk screen.
export struct JunkRow {
    /// 0 category heading, 1 rule, 2 item (a path), 3 note.
    kind: int,
    /// The rule's index for rules; the item's id for items, -1 for the
    /// "and N more" line.
    id: int,
    title: string,
    subtitle: string,
    detail: string,
    /// Rules: whether it's ticked, whether it can be, whether its items
    /// are shown.
    ticked: bool,
    enabled: bool,
    open: bool,
    /// Button text: tool rules get "Open settings", items "Show", a
    /// command its Run button; empty for none.
    action: string,
    /// Tool rules: "Show command" or "Hide command"; empty for none.
    second: string,
    /// A warning beside the title ("Edge is open").
    badge: string,
}

/// One row of a quarantined batch's page.
export struct QuarantineRow {
    /// 0 a heading (a rule, or the folder items came from), 1 an item of
    /// the batch, 2 something inside a folder item.
    kind: int,
    /// For the callbacks; -1 for headings.
    id: int,
    title: string,
    subtitle: string,
    detail: string,
    is-dir: bool,
    ticked: bool,
    /// Programs and scripts aren't opened from the quarantine.
    can-open: bool,
}

/// One rule of a clean, on the progress and results pages.
export struct JunkStep {
    title: string,
    detail: string,
    /// 0 waiting, 1 cleaning now, 2 done, 3 failed, 4 left out (stopped).
    state: int,
}

/// A button of the app sheet.
export struct SheetAction {
    id: string,
    label: string,
    primary: bool,
}

export struct TypeRow {
    /// The extension without the dot; empty for files without one.
    key: string,
    label: string,
    size: string,
    files: string,
    fraction: float,
    color: color,
}

/// One row of the home screen.
export struct HomeRow {
    /// 0 drive or folder, 1 section heading, 2 storage breakdown, 3 app,
    /// 4 notice, 5 app group, 6 storage chart, 7 app bubbles, 8 the header
    /// of a group's page, 9 a setting with a few choices.
    kind: int,
    title: string,
    subtitle: string,
    detail: string,
    fraction: float,
    /// Path for drives, package name for apps, action id for headings,
    /// notices, groups and the page header's button.
    key: string,
    /// Button text for headings and notices; empty for none.
    action: string,
    /// A notice's second, plain button and its action id.
    action2: string,
    key2: string,
    /// Notices: a tap on the card opens this (a quarantined batch's page);
    /// empty for none.
    open-key: string,
    /// Choice rows (9): the options, and which one is on.
    choices: [string],
    chosen: int,
    /// Apps: where it came from and when it was last used. Drives: how
    /// fast they fill up.
    tags: string,
    /// Apps: shown in the warning color (no store can reinstall it).
    /// Drives: full within a month at this rate.
    warn: bool,
    /// Storage breakdown: each part's share of the bar and its legend text.
    apps: float,
    files: float,
    system: float,
    apps-label: string,
    files-label: string,
    system-label: string,
    free-label: string,
    /// Storage chart: SVG paths of the stacked areas in a 1000 × 100 box,
    /// and the dates at either end.
    chart-used: string,
    chart-files: string,
    chart-apps: string,
    chart-start: string,
    chart-end: string,
}

/// One place in the sidebar (wide windows) or the tab bar (phones).
export struct NavItem {
    key: string,
    label: string,
    /// A count to show beside it, or empty.
    badge: string,
}

global Theme {
    out property <color> dim: Palette.foreground.transparentize(45%);
    out property <color> apps: #4f8ff7;
    out property <color> files: #34a853;
    out property <color> system: #f4b400;
    out property <color> danger: #d64545;
    out property <color> warn: Palette.color-scheme == ColorScheme.dark ? #f6a35c : #b85c00;
    out property <color> track: Palette.color-scheme == ColorScheme.dark ? #ffffff1f : #0000001a;
    out property <color> rebuild: #2fbf71;
    /// Behind a row while a finger is on it.
    out property <color> pressed: Palette.foreground.transparentize(86%);
}

/// Icons for kinds of content, in the order of `freesize_core::Kind`, then
/// "can be rebuilt" (12) and "more" (13).
global Icons {
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> file: @image-url("icons/file.svg");
    out property <image> video: @image-url("icons/video.svg");
    out property <image> picture: @image-url("icons/image.svg");
    out property <image> audio: @image-url("icons/audio.svg");
    out property <image> archive: @image-url("icons/archive.svg");
    out property <image> disc: @image-url("icons/disc.svg");
    out property <image> document: @image-url("icons/document.svg");
    out property <image> code: @image-url("icons/code.svg");
    out property <image> program: @image-url("icons/program.svg");
    out property <image> game: @image-url("icons/game.svg");
    out property <image> database: @image-url("icons/database.svg");
    out property <image> rebuild: @image-url("icons/rebuild.svg");
    out property <image> more: @image-url("icons/more.svg");

    public pure function of(kind: int) -> image {
        return kind == 1 ? self.file : kind == 2 ? self.video : kind == 3 ? self.picture : kind == 4 ? self.audio : kind == 5 ? self.archive : kind == 6 ? self.disc : kind == 7 ? self.document : kind == 8 ? self.code : kind == 9 ? self.program : kind == 10 ? self.game : kind == 11 ? self.database : kind == 12 ? self.rebuild : kind == 13 ? self.more : self.folder;
    }
}

component SizeBar inherits Rectangle {
    in property <float> fraction;
    in property <color> fill: Palette.accent-background;
    height: 8px;
    border-radius: 3px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * root.fraction;
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
    }
}

component Chevron inherits Rectangle {
    in property <bool> expanded;
    in property <color> tint;
    width: 16px;
    height: 16px;
    Path {
        width: 9px;
        height: 9px;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: root.expanded ? "M 0 2 L 8 2 L 4 7 Z" : "M 2 0 L 7 4 L 2 8 Z";
        fill: root.tint;
    }
}

component TreePane inherits Rectangle {
    in property <[TreeRow]> rows;
    in property <int> selected-id;
    in property <length> row-height;
    in property <bool> compact;
    in-out property <length> scroll-y;
    callback toggle(int);
    callback select(int);

    list := ListView {
        content-y <=> root.scroll-y;
        for row[index] in root.rows: Rectangle {
            property <bool> selected: row.id == root.selected-id && !row.summary;
            height: root.row-height;
            background: self.selected ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;

            touch := TouchArea {
                clicked => {
                    if (!row.summary) {
                        root.select(row.id);
                    }
                }
                double-clicked => {
                    if (row.expandable) {
                        root.toggle(index);
                    }
                }
            }

            HorizontalLayout {
                padding-left: 4px + row.depth * 14px;
                padding-right: 8px;
                spacing: 6px;
                Rectangle {
                    width: 18px;
                    if row.expandable: Chevron {
                        expanded: row.expanded;
                        tint: selected ? Palette.selection-foreground : Palette.foreground;
                        TouchArea {
                            clicked => {
                                root.toggle(index);
                            }
                        }
                    }
                }

                Text {
                    text: row.name;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                    font-weight: row.is-dir ? 600 : 400;
                    font-italic: row.summary;
                    color: selected ? Palette.selection-foreground : row.summary ? Theme.dim : Palette.foreground;
                }

                if row.note != "": Text {
                    text: row.note;
                    font-size: 11px;
                    vertical-alignment: center;
                    color: Theme.danger;
                }
                Rectangle {
                    width: root.compact ? 44px : 64px;
                    SizeBar {
                        width: 100%;
                        fraction: row.fraction;
                        fill: selected ? Palette.selection-foreground : Palette.accent-background;
                    }
                }

                if !root.compact: Text {
                    text: row.percent;
                    width: 44px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: selected ? Palette.selection-foreground : Theme.dim;
                }

                Text {
                    text: row.size;
                    width: 70px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: selected ? Palette.selection-foreground : Palette.foreground;
                }
            }
        }
    }
}

component TreemapPane inherits Rectangle {
    in property <[MapRect]> rects;
    in property <int> selected-id;
    callback select(int);
    callback resized(length, length);

    clip: true;
    background: Theme.track;

    init => {
        root.resized(self.width, self.height);
    }
    changed width => {
        root.resized(self.width, self.height);
    }
    changed height => {
        root.resized(self.width, self.height);
    }

    for r in root.rects: Rectangle {
        x: r.x;
        y: r.y;
        width: r.width;
        height: r.height;
        background: r.color;
        border-width: r.id == root.selected-id || r.ring ? 2px : 1px;
        border-color: r.id == root.selected-id ? Palette.foreground : r.ring ? Theme.rebuild : r.color.darker(40%);

        if r.icon-size > 0 && !r.nested: Image {
            x: (parent.width - self.width) / 2;
            // Centred, but below a two-line label.
            y: max((parent.height - self.height) / 2 + 7px, r.label != "" ? 34px : 0);
            width: r.icon-size;
            height: r.icon-size;
            source: r.has-app-icon ? r.app-icon : Icons.of(r.icon);
            colorize: r.has-app-icon ? transparent : r.text-color.transparentize(35%);
            image-fit: contain;
        }
        if r.icon-size > 0 && r.nested: Image {
            x: 3px;
            y: 2px;
            width: 12px;
            height: 12px;
            source: r.has-app-icon ? r.app-icon : Icons.of(r.icon);
            colorize: r.has-app-icon ? transparent : r.text-color;
            image-fit: contain;
        }
        if r.label != "": Text {
            x: r.nested && r.icon-size > 0 ? 17px : 4px;
            y: 2px;
            width: parent.width - self.x - 4px;
            height: r.nested ? 14px : parent.height - 4px;
            text: r.label;
            color: r.text-color;
            font-size: 11px;
            overflow: elide;
            wrap: r.nested ? no-wrap : word-wrap;
            vertical-alignment: top;
        }
        TouchArea {
            clicked => {
                root.select(r.id);
            }
        }
    }
}

/// The folder's contents as circles sized by space; tapping one zooms into
/// it (it becomes the shown folder).
component BubblePane inherits Rectangle {
    in property <[BubbleItem]> bubbles;
    in property <int> selected-id;
    callback select(int, string);
    callback resized(length, length);

    clip: true;
    background: Palette.alternate-background;

    init => {
        root.resized(self.width, self.height);
    }
    changed width => {
        root.resized(self.width, self.height);
    }
    changed height => {
        root.resized(self.width, self.height);
    }

    // Circles first, then every label above them; labels don't take taps.
    for b in root.bubbles: Rectangle {
        // Grows in when the view changes.
        property <float> grow: 0;
        init => {
            self.grow = 1;
        }
        animate grow {
            duration: 260ms;
            easing: ease-out;
        }
        x: b.x - b.r * self.grow;
        y: b.y - b.r * self.grow;
        width: b.r * 2 * self.grow;
        height: self.width;
        border-radius: self.width / 2;
        background: b.color;
        border-width: b.id == root.selected-id || b.ring ? 3px : b.depth == 0 ? 1px : 0;
        border-color: b.id == root.selected-id ? Palette.foreground : b.ring ? Theme.rebuild : b.color.darker(25%);
        if b.icon-size > 0 && !b.pill && b.label == "": Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: b.icon-size * parent.grow;
            height: self.width;
            source: b.has-app-icon ? b.app-icon : Icons.of(b.icon);
            colorize: b.has-app-icon ? transparent : b.text-color.transparentize(40%);
            image-fit: contain;
        }
        TouchArea {
            clicked => {
                if (b.id >= 0 || b.key != "") {
                    root.select(b.id, b.key);
                }
            }
        }
    }

    for b in root.bubbles: Rectangle {
        property <float> shown: 0;
        init => {
            self.shown = 1;
        }
        animate shown {
            duration: 400ms;
            easing: ease-in;
        }
        visible: b.label != "";
        opacity: self.shown;
        x: b.x - self.width / 2;
        y: b.y - self.height / 2;
        width: min(b.r * 1.7, max(name.preferred-width, detail.preferred-width, b.icon-size) + 16px);
        height: label.preferred-height + 8px;
        border-radius: 8px;
        background: b.pill ? #000000a0 : transparent;
        label := VerticalLayout {
            padding: 4px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 2px;
            alignment: center;
            if b.icon-size > 0: Image {
                height: b.icon-size;
                width: b.icon-size;
                x: (parent.width - self.width) / 2;
                source: b.has-app-icon ? b.app-icon : Icons.of(b.icon);
                colorize: b.has-app-icon ? transparent : b.pill ? #ffffffd0 : b.text-color.transparentize(25%);
                image-fit: contain;
            }
            name := Text {
                text: b.label;
                horizontal-alignment: center;
                overflow: elide;
                font-size: b.r > 70px ? 13px : 11px;
                font-weight: 600;
                color: b.pill ? #ffffff : b.text-color;
            }

            detail := Text {
                visible: b.detail != "";
                height: b.detail != "" ? self.preferred-height : 0;
                text: b.detail;
                horizontal-alignment: center;
                overflow: elide;
                font-size: 11px;
                color: b.pill ? #ffffffd0 : b.text-color.transparentize(20%);
            }
        }
    }
}

/// Root › … › folder — size. Each step can be tapped to go back to it.
component Breadcrumb inherits HorizontalLayout {
    in property <[Crumb]> crumbs;
    in property <string> size;
    callback select(int);

    height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    spacing: 4px;
    alignment: center;
    for c[i] in root.crumbs: HorizontalLayout {
        spacing: 4px;
        if i > 0: Text {
            text: "›";
            color: Theme.dim;
            vertical-alignment: center;
        }
        Rectangle {
            crumb-text := Text {
                width: 100%;
                height: 100%;
                text: c.label;
                overflow: elide;
                vertical-alignment: center;
                font-weight: i == root.crumbs.length - 1 ? 600 : 400;
                color: i == root.crumbs.length - 1 ? Palette.foreground : crumb-touch.has-hover ? Palette.accent-background : Theme.dim;
            }

            crumb-touch := TouchArea {
                clicked => {
                    root.select(c.id);
                }
            }
        }
    }
    Text {
        text: root.size;
        color: Theme.dim;
        vertical-alignment: center;
    }
}

/// The treemap or the bubbles, with a switch between them.
component MapView inherits Rectangle {
    in property <[MapRect]> rects;
    in property <[BubbleItem]> bubbles;
    in property <int> selected-id;
    in-out property <bool> bubbles-view;
    callback select(int);
    callback map-resized(length, length);
    callback bubbles-resized(length, length);
    callback view-changed();

    if !root.bubbles-view: TreemapPane {
        rects: root.rects;
        selected-id: root.selected-id;
        select(id) => {
            root.select(id);
        }
        resized(w, h) => {
            root.map-resized(w, h);
        }
    }
    if root.bubbles-view: BubblePane {
        bubbles: root.bubbles;
        selected-id: root.selected-id;
        select(id, key) => {
            root.select(id);
        }
        resized(w, h) => {
            root.bubbles-resized(w, h);
        }
    }

    Rectangle {
        x: parent.width - self.width - 8px;
        y: parent.height - self.height - 8px;
        width: switch.preferred-width;
        height: 30px;
        border-radius: 15px;
        background: Palette.background.transparentize(8%);
        border-width: 1px;
        border-color: Palette.border;
        switch := HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            for option[i] in ["Treemap", "Bubbles"]: choice := Rectangle {
                property <bool> on: (i == 1) == root.bubbles-view;
                border-radius: 12px;
                background: self.on ? Palette.accent-background : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: option;
                        font-size: 12px;
                        vertical-alignment: center;
                        color: choice.on ? Palette.accent-foreground : Palette.foreground;
                    }
                }

                TouchArea {
                    clicked => {
                        root.bubbles-view = i == 1;
                        root.view-changed();
                    }
                }
            }
        }
    }
}

component LargestPane inherits Rectangle {
    in property <[FileRow]> files;
    in property <int> selected-id;
    /// Set when only one file type is listed.
    in property <string> filter;
    callback select(int);
    callback clear-filter();
    /// Puts every listed file in the basket.
    callback collect-all();

    VerticalLayout {
        if root.filter != "": Rectangle {
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 6px;
                padding-left: 10px;
                spacing: 8px;
                Text {
                    text: root.filter;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    font-weight: 600;
                }

                Button {
                    text: "Select all";
                    clicked => {
                        root.collect-all();
                    }
                }

                Button {
                    text: "Show all";
                    clicked => {
                        root.clear-filter();
                    }
                }
            }
        }
        ListView {
            for file in root.files: Rectangle {
                property <bool> selected: file.id == root.selected-id;
                height: 46px;
                background: self.selected ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;
                touch := TouchArea {
                    clicked => {
                        root.select(file.id);
                    }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: file.name;
                            overflow: elide;
                            color: selected ? Palette.selection-foreground : Palette.foreground;
                        }

                        Text {
                            text: file.folder;
                            overflow: elide;
                            font-size: 11px;
                            color: selected ? Palette.selection-foreground : Theme.dim;
                        }
                    }

                    Rectangle {
                        width: 64px;
                        SizeBar {
                            width: 100%;
                            fraction: file.fraction;
                            fill: selected ? Palette.selection-foreground : Palette.accent-background;
                        }
                    }

                    Text {
                        text: file.size;
                        width: 70px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        color: selected ? Palette.selection-foreground : Palette.foreground;
                    }
                }
            }
        }
    }
}

/// Folders tools rebuild, old large files and duplicates. Selecting a row
/// selects the item in the tree, where the selection bar can delete it.
component CleanupPane inherits Rectangle {
    in property <[CleanRow]> rows;
    in property <int> selected-id;
    callback select(int);
    /// A heading's button; gives the heading's title.
    callback action(string);

    // Sized like the home screen's list; see HomePane.
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(column.preferred-height, end.y + 10px);
        column := VerticalLayout {
            y: 0;
            width: scroll.visible-width;
            height: self.preferred-height * 2 + 1000px;
            alignment: start;
            padding: 10px;
            for row in root.rows: VerticalLayout {
                if row.kind == 0: VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 6px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: row.title;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }

                        if row.action != "": Button {
                            text: row.action;
                            clicked => {
                                root.action(row.title);
                            }
                        }
                    }

                    if row.subtitle != "": Text {
                        text: row.subtitle;
                        font-size: 12px;
                        color: Theme.dim;
                        wrap: word-wrap;
                    }
                }

                if row.kind == 1: Rectangle {
                    property <bool> selected: row.id == root.selected-id;
                    height: row.has-image ? 64px : 46px;
                    border-radius: 6px;
                    background: self.selected ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;
                    touch := TouchArea {
                        clicked => {
                            root.select(row.id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        if row.has-image: Rectangle {
                            width: 56px;
                            height: 56px;
                            y: 4px;
                            border-radius: 6px;
                            clip: true;
                            background: Theme.track;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: row.image;
                                image-fit: cover;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: row.title;
                                overflow: elide;
                                color: selected ? Palette.selection-foreground : Palette.foreground;
                            }

                            Text {
                                text: row.subtitle;
                                overflow: elide;
                                font-size: 11px;
                                color: selected ? Palette.selection-foreground : Theme.dim;
                            }
                        }

                        if row.detail != "": Text {
                            text: row.detail;
                            vertical-alignment: center;
                            color: selected ? Palette.selection-foreground : Palette.foreground;
                        }
                    }
                }

                if row.kind == 2: Text {
                    text: row.title;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.dim;
                    height: 26px;
                    vertical-alignment: bottom;
                }

                if row.kind == 3: Rectangle {
                    height: batch.preferred-height + 12px;
                    border-radius: 6px;
                    background: Palette.alternate-background;
                    batch := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        y: 6px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: row.title;
                                wrap: word-wrap;
                            }

                            Text {
                                text: row.subtitle;
                                wrap: word-wrap;
                                font-size: 11px;
                                color: Theme.dim;
                            }
                        }

                        Text {
                            text: row.detail;
                            vertical-alignment: center;
                        }

                        Button {
                            text: "Put back";
                            clicked => {
                                root.action("restore " + row.action);
                            }
                        }

                        Button {
                            text: "Empty";
                            clicked => {
                                root.action("empty " + row.action);
                            }
                        }
                    }
                }
            }

            end := Rectangle {
                height: 0px;
            }
        }
    }
}

/// A tick box drawn by hand, so it follows the model and is big enough to
/// tap.
component Tick inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    width: 36px;
    height: 36px;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled();
        }
    }

    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        border-width: root.checked ? 0 : 2px;
        border-color: touch.has-hover ? Palette.accent-background : Palette.foreground.transparentize(55%);
        background: root.checked ? Palette.accent-background : transparent;
        opacity: root.enabled ? 1 : 0.4;
        if root.checked: Path {
            width: 14px;
            height: 14px;
            viewbox-width: 14;
            viewbox-height: 14;
            commands: "M 2 7.5 L 5.5 11 L 12 3.5";
            stroke: Palette.accent-foreground;
            stroke-width: 2.2px;
        }
    }
}

/// A small rounded label.
component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> warn;
    in property <bool> accent;
    /// Over a picture: an opaque background.
    in property <bool> solid;
    height: 20px;
    width: label.preferred-width + 12px;
    border-radius: 10px;
    background: root.solid ? Palette.accent-background : root.warn ? Theme.warn.transparentize(80%) : root.accent ? Palette.accent-background.transparentize(80%) : Theme.track;
    label := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: root.solid ? Palette.accent-foreground : root.warn ? Theme.warn : root.accent ? Palette.accent-background : Palette.foreground;
        vertical-alignment: center;
    }
}

/// A photo of a similar set: a big preview with its tick box over it.
component PhotoTile inherits Rectangle {
    in property <CleanRow> photo;
    in property <bool> selected;
    callback select();
    callback open();
    callback check();
    in property <length> size: 156px;
    width: root.size;
    height: root.size + 52px;
    Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: 8px;
        clip: true;
        background: Theme.track;
        Image {
            width: 100%;
            height: 100%;
            source: root.photo.image;
            image-fit: cover;
            opacity: root.photo.checked ? 0.6 : 1;
        }

        if !root.photo.has-image: Text {
            text: "No preview";
            font-size: 11px;
            color: Theme.dim;
        }
        TouchArea {
            clicked => {
                root.select();
            }
            double-clicked => {
                root.open();
            }
        }

        if root.photo.badge != "": Badge {
            x: 6px;
            y: parent.height - self.height - 6px;
            text: root.photo.badge;
            solid: true;
        }
        if root.photo.checkable: Rectangle {
            x: 2px;
            y: 2px;
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: Palette.background.transparentize(25%);
            Tick {
                checked: root.photo.checked;
                toggled => {
                    root.check();
                }
            }
        }
    }

    Rectangle {
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: 8px;
        border-width: root.photo.checked ? 3px : root.selected ? 2px : 0;
        border-color: root.photo.checked ? Theme.danger : Palette.accent-background;
    }

    VerticalLayout {
        y: root.size + 4px;
        height: 46px;
        Text {
            text: root.photo.title;
            overflow: elide;
            font-size: 12px;
        }

        Text {
            text: root.photo.detail + " · " + root.photo.subtitle;
            overflow: elide;
            font-size: 11px;
            color: Theme.dim;
        }
    }
}

/// The Clean up tab: an overview of cards, each opening a page of rows to
/// tick. Ticked rows are in the basket, whose bar sits under the tab.
component CleanupView inherits Rectangle {
    in property <[CleanSection]> sections;
    in property <string> summary;
    /// The open page's key; empty on the overview.
    in property <string> page;
    in property <string> page-title;
    in property <string> page-blurb;
    in property <string> page-size;
    in property <string> page-action;
    in property <string> page-picked;
    in property <bool> page-warn;
    in property <[CleanRow]> rows;
    /// Similar photos, shown instead of `rows` when there are any.
    in property <[PhotoSet]> photo-sets;
    /// Type choices, "Every type" first; empty for none.
    in property <[string]> filters;
    in-out property <int> filter-index;
    /// The "select all" button's label; empty for none.
    in property <string> pick-label;
    in property <bool> any-picked;
    in property <int> selected-id;
    in property <bool> compact;
    callback open(string);
    callback back();
    /// A card's or page's button, by section key; a quarantine batch's
    /// buttons send "restore <id>" or "empty <id>".
    callback action(string);
    callback select(int);
    callback open-item(int);
    callback check(int);
    /// A group's "select extras", by the group's index.
    callback group(int);
    callback pick-all();
    callback pick-none();
    callback filter-changed(int);

    changed page => {
        scroll.content-y = 0;
    }

    // Sized like the home screen's list; see HomePane.
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(column.preferred-height, bottom.y + 10px);
        column := VerticalLayout {
            y: 0;
            width: scroll.visible-width;
            height: self.preferred-height * 2 + 1000px;
            alignment: start;
            padding: root.compact ? 8px : 12px;
            spacing: 8px;

            // ----- Overview -----
            if root.page == "": VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Clean up";
                    font-size: 18px;
                    font-weight: 600;
                }

                Text {
                    text: root.summary;
                    font-size: 12px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }
            }
            if root.page == "": VerticalLayout {
                spacing: 8px;
                for section in root.sections: Rectangle {
                    height: card.preferred-height;
                    border-radius: 8px;
                    background: card-touch.has-hover && section.has-page ? Palette.alternate-background.darker(4%) : Palette.alternate-background;
                    border-width: 1px;
                    border-color: section.warn ? Theme.warn.transparentize(50%) : Palette.border;
                    card-touch := TouchArea {
                        enabled: section.has-page;
                        mouse-cursor: section.has-page ? pointer : default;
                        clicked => {
                            root.open(section.key);
                        }
                    }

                    card := HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: section.title;
                                font-size: 14px;
                                font-weight: 600;
                                wrap: word-wrap;
                                color: section.warn ? Theme.warn : Palette.foreground;
                            }

                            Text {
                                text: section.note;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }

                            if section.picked != "": Text {
                                text: section.picked;
                                font-size: 12px;
                                font-weight: 600;
                                color: Palette.accent-background;
                            }
                        }

                        if section.size != "" && !root.compact: Text {
                            text: section.size;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if section.action != "": VerticalLayout {
                            alignment: center;
                            Button {
                                text: section.action;
                                clicked => {
                                    root.action(section.key);
                                }
                            }
                        }
                        if section.has-page: VerticalLayout {
                            alignment: center;
                            Button {
                                text: "Review";
                                primary: section.action == "" || section.action == "Search again";
                                clicked => {
                                    root.open(section.key);
                                }
                            }
                        }
                    }
                }
            }

            // ----- A section's page -----
            if root.page != "": VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "‹ All";
                        clicked => {
                            root.back();
                        }
                    }

                    Text {
                        text: root.page-title;
                        font-size: 17px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                        color: root.page-warn ? Theme.warn : Palette.foreground;
                    }

                    if root.page-size != "": Text {
                        text: root.page-size;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.page-blurb;
                    font-size: 12px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }

                if root.filters.length > 0: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Show";
                        vertical-alignment: center;
                    }

                    ComboBox {
                        horizontal-stretch: 1;
                        model: root.filters;
                        current-index <=> root.filter-index;
                        selected => {
                            root.filter-changed(self.current-index);
                        }
                    }
                }
                if root.pick-label != "" || root.page-action != "": HorizontalLayout {
                    spacing: 8px;
                    if root.pick-label != "": Button {
                        text: root.pick-label;
                        primary: true;
                        clicked => {
                            root.pick-all();
                        }
                    }
                    if root.pick-label != "": Button {
                        text: "Clear";
                        enabled: root.any-picked;
                        clicked => {
                            root.pick-none();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.page-action != "": Button {
                        text: root.page-action;
                        clicked => {
                            root.action(root.page);
                        }
                    }
                }
                if root.page-picked != "": Text {
                    text: root.page-picked;
                    font-size: 12px;
                    font-weight: 600;
                    color: Palette.accent-background;
                    wrap: word-wrap;
                }
            }
            if root.page != "" && root.photo-sets.length > 0: VerticalLayout {
                spacing: 4px;
                for set in root.photo-sets: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        padding-top: 10px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: end;
                            horizontal-stretch: 1;
                            Text {
                                text: set.title;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }

                            if set.warning != "": Text {
                                text: set.warning;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.warn;
                                wrap: word-wrap;
                            }
                        }

                        if set.action != "": Button {
                            text: set.action;
                            clicked => {
                                root.group(set.index);
                            }
                        }
                    }

                    // Tiles wrap onto as many lines as the width needs.
                    tiles := Rectangle {
                        property <int> columns: max(2, floor((self.width + 8px) / 164px));
                        property <length> tile: (self.width - (self.columns - 1) * 8px) / self.columns;
                        height: ceil(set.photos.length / self.columns) * (self.tile + 58px);
                        for photo[i] in set.photos: PhotoTile {
                            size: tiles.tile;
                            x: mod(i, tiles.columns) * (tiles.tile + 8px);
                            y: floor(i / tiles.columns) * (tiles.tile + 58px);
                            photo: photo;
                            selected: photo.id == root.selected-id;
                            select => {
                                root.select(photo.id);
                            }
                            open => {
                                root.open-item(photo.id);
                            }
                            check => {
                                root.check(photo.id);
                            }
                        }
                    }
                }
            }
            if root.page != "" && root.photo-sets.length == 0: VerticalLayout {
                for row in root.rows: VerticalLayout {
                    if row.kind == 0: VerticalLayout {
                        padding-top: 10px;
                        padding-bottom: 6px;
                        Text {
                            text: row.title;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }

                        if row.subtitle != "": Text {
                            text: row.subtitle;
                            font-size: 12px;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }
                    }

                    if row.kind == 1: Rectangle {
                        property <bool> selected: row.id == root.selected-id;
                        height: row.has-image ? 84px : root.compact ? 56px : 48px;
                        border-radius: 6px;
                        background: self.selected ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;
                        touch := TouchArea {
                            clicked => {
                                root.select(row.id);
                            }
                            double-clicked => {
                                root.open-item(row.id);
                            }
                        }

                        HorizontalLayout {
                            padding-left: row.checkable ? 0px : 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            if row.checkable: VerticalLayout {
                                alignment: center;
                                Tick {
                                    checked: row.checked;
                                    toggled => {
                                        root.check(row.id);
                                    }
                                }
                            }
                            if row.has-image: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 76px;
                                    height: 76px;
                                    border-radius: 6px;
                                    clip: true;
                                    background: Theme.track;
                                    border-width: row.checked ? 3px : 0;
                                    border-color: Theme.danger;
                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        source: row.image;
                                        image-fit: cover;
                                        opacity: row.checked ? 0.55 : 1;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: row.title;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: selected ? Palette.selection-foreground : Palette.foreground;
                                    }

                                    if row.badge != "": Badge {
                                        text: row.badge;
                                        warn: row.warn;
                                        accent: !row.warn;
                                    }
                                }

                                Text {
                                    text: row.subtitle;
                                    overflow: elide;
                                    font-size: 11px;
                                    color: selected ? Palette.selection-foreground : Theme.dim;
                                }
                            }

                            if row.detail != "": Text {
                                text: row.detail;
                                vertical-alignment: center;
                                color: selected ? Palette.selection-foreground : Palette.foreground;
                            }
                        }
                    }

                    if row.kind == 2: HorizontalLayout {
                        padding-top: 10px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: end;
                            horizontal-stretch: 1;
                            Text {
                                text: row.title;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }

                            if row.warn: Text {
                                text: row.subtitle;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.warn;
                                wrap: word-wrap;
                            }
                        }

                        if row.action != "": Button {
                            text: row.action;
                            clicked => {
                                root.group(row.id);
                            }
                        }
                    }

                    if row.kind == 3: Rectangle {
                        height: batch.preferred-height + 12px;
                        border-radius: 6px;
                        background: Palette.alternate-background;
                        batch := HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            y: 6px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: row.title;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: row.subtitle;
                                    wrap: word-wrap;
                                    font-size: 11px;
                                    color: Theme.dim;
                                }
                            }

                            if !root.compact: Text {
                                text: row.detail;
                                vertical-alignment: center;
                            }
                            Button {
                                text: "Put back";
                                clicked => {
                                    root.action("restore " + row.action);
                                }
                            }

                            Button {
                                text: "Empty";
                                clicked => {
                                    root.action("empty " + row.action);
                                }
                            }
                        }
                    }
                }
            }

            bottom := Rectangle {
                height: 0px;
            }
        }
    }
}

component Card inherits Rectangle {
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;
}

/// One quarantined batch, like a file manager shows a folder: its items
/// grouped by the rule or folder they came from, each with Open, Show,
/// Put back and Delete; folders open to what's inside.
component QuarantinePane inherits Rectangle {
    in property <[QuarantineRow]> rows;
    in property <string> title;
    in property <string> subtitle;
    in property <string> crumbs;
    in property <string> picked;
    in property <bool> busy;
    in property <bool> can-reveal;
    in property <bool> compact;
    in property <length> top-inset;
    in property <length> bottom-inset;
    callback back();
    callback toggle(int);
    /// Opens a file with its app, or a folder here.
    callback open(int);
    callback reveal(int);
    callback restore(int);
    callback delete(int);
    /// The ticked items, or all of them when none is.
    callback restore-chosen();
    callback delete-chosen();
    background: Palette.background;

    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-top: 12px + root.top-inset;
            spacing: 10px;
            Button {
                text: "‹ Back";
                clicked => {
                    root.back();
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.crumbs != "" ? root.crumbs : root.title;
                    font-size: 18px;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: root.subtitle;
                    font-size: 12px;
                    color: Theme.dim;
                    overflow: elide;
                }
            }
        }

        // What the buttons act on, and the buttons; inside a folder the
        // batch's page is where they are.
        if root.crumbs == "": Rectangle {
            height: bar.preferred-height + 12px;
            Card {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height - 4px;
                y: 0;
                background: Palette.alternate-background;
                bar := HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    Text {
                        text: root.picked != "" ? root.picked : "Tick items to choose some, or act on all of them.";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        font-size: 12px;
                        font-weight: root.picked != "" ? 600 : 400;
                        color: root.picked != "" ? Palette.foreground : Theme.dim;
                        wrap: word-wrap;
                    }

                    Button {
                        text: root.picked != "" ? "Put back" : "Put back all";
                        primary: true;
                        enabled: !root.busy;
                        clicked => {
                            root.restore-chosen();
                        }
                    }

                    Button {
                        text: root.picked != "" ? "Delete for good…" : "Empty all…";
                        enabled: !root.busy;
                        clicked => {
                            root.delete-chosen();
                        }
                    }
                }
            }
        }

        scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: max(column.preferred-height, end.y + 10px);
            column := VerticalLayout {
                y: 0;
                width: scroll.visible-width;
                height: self.preferred-height * 2 + 1000px;
                alignment: start;
                padding: 10px;
                padding-bottom: 10px + root.bottom-inset;
                for row in root.rows: VerticalLayout {
                    if row.kind == 0: HorizontalLayout {
                        padding-top: 12px;
                        padding-bottom: 4px;
                        padding-left: 4px;
                        spacing: 8px;
                        Text {
                            text: row.title;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                            color: row.id < 0 && row.detail == "" ? Theme.dim : Palette.foreground;
                        }

                        Text {
                            text: row.detail;
                            font-weight: 600;
                            font-size: 12px;
                        }
                    }

                    if row.kind != 0: Rectangle {
                        height: line.preferred-height + 8px;
                        border-radius: 6px;
                        background: touch.pressed ? Theme.pressed : touch.has-hover ? Palette.alternate-background : transparent;
                        touch := TouchArea {
                            clicked => {
                                if (row.is-dir) {
                                    root.open(row.id);
                                } else if (row.kind == 1) {
                                    root.toggle(row.id);
                                }
                            }
                        }

                        line := HorizontalLayout {
                            y: 4px;
                            padding-right: 6px;
                            padding-left: row.kind == 2 ? 10px : 0px;
                            spacing: 8px;
                            if row.kind == 1: Tick {
                                checked: row.ticked;
                                toggled => {
                                    root.toggle(row.id);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: row.is-dir ? Icons.folder : Icons.file;
                                    width: 20px;
                                    height: 20px;
                                    colorize: row.is-dir ? Palette.accent-background : Theme.dim;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: row.title;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        font-weight: row.kind == 1 ? 600 : 400;
                                    }

                                    Text {
                                        text: row.detail;
                                        font-size: 12px;
                                        color: Theme.dim;
                                    }
                                }

                                if row.subtitle != "": Text {
                                    text: row.subtitle;
                                    font-size: 11px;
                                    color: Theme.dim;
                                    overflow: elide;
                                }
                                if root.compact: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    if row.can-open: Button {
                                        text: "Open";
                                        clicked => {
                                            root.open(row.id);
                                        }
                                    }
                                    if row.kind == 1: Button {
                                        text: "Put back";
                                        clicked => {
                                            root.restore(row.id);
                                        }
                                    }
                                    if row.kind == 1: Button {
                                        text: "Delete…";
                                        clicked => {
                                            root.delete(row.id);
                                        }
                                    }
                                }
                            }

                            if !root.compact: HorizontalLayout {
                                spacing: 6px;
                                alignment: center;
                                if row.can-open: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Open";
                                        clicked => {
                                            root.open(row.id);
                                        }
                                    }
                                }
                                if root.can-reveal: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Show in folder";
                                        clicked => {
                                            root.reveal(row.id);
                                        }
                                    }
                                }
                                if row.kind == 1: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Put back";
                                        clicked => {
                                            root.restore(row.id);
                                        }
                                    }
                                }
                                if row.kind == 1: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Delete for good…";
                                        clicked => {
                                            root.delete(row.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                end := Rectangle {
                    height: 0px;
                }
            }
        }
    }
}

/// One rule of a clean, on the progress and results pages.
component JunkStepRow inherits Rectangle {
    in property <JunkStep> step;
    height: max(32px, line.preferred-height + 12px);
    line := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 10px;
        Rectangle {
            width: 20px;
            if root.step.state == 1: Spinner {
                width: 18px;
                height: 18px;
                indeterminate: true;
            }
            if root.step.state != 1: Text {
                // Waiting, running, done, failed, left out.
                text: root.step.state == 2 ? "✓" : root.step.state == 3 ? "!" : root.step.state == 4 ? "–" : "○";
                font-size: 15px;
                font-weight: 700;
                color: root.step.state == 2 ? Theme.rebuild : root.step.state == 3 ? Theme.warn : Theme.dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.step.title;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
            font-weight: root.step.state == 1 ? 600 : 400;
            color: root.step.state == 0 || root.step.state == 4 ? Theme.dim : Palette.foreground;
        }

        Text {
            text: root.step.detail;
            vertical-alignment: center;
            horizontal-alignment: right;
            font-size: 12px;
            wrap: word-wrap;
            max-width: 340px;
            color: root.step.state == 3 ? Theme.warn : Theme.dim;
        }
    }
}

/// The Clean junk screen: the rules by category, ticked where it's safe,
/// with the ones only the system's own tools clean last; then the
/// progress of a clean, and what it did.
component JunkPane inherits Rectangle {
    in property <[JunkRow]> rows;
    /// 0 the list, 1 cleaning, 2 the results.
    in property <int> stage;
    in property <string> headline;
    in property <string> summary;
    in property <bool> busy;
    in property <string> clean-label;
    in property <bool> can-clean;
    in property <[JunkStep]> steps;
    in property <float> fraction;
    in property <string> progress-line;
    in property <bool> stopping;
    in property <string> result-title;
    in property <string> result-text;
    in property <bool> has-quarantined;
    in property <bool> compact;
    in property <length> top-inset;
    in property <length> bottom-inset;
    callback close();
    callback toggle(int);
    callback expand(int);
    /// Shows an item's path in the file manager.
    callback show(int);
    /// Opens the settings page of a rule removed with its own tool.
    callback tool(int);
    /// Shows or hides that rule's command.
    callback command(int);
    /// Runs it, after asking.
    callback run(int);
    callback clean();
    callback again();
    callback stop();
    callback done();
    callback open-quarantine();
    background: Palette.background;

    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-top: 12px + root.top-inset;
            spacing: 8px;
            Text {
                text: root.stage == 1 ? "Cleaning" : root.stage == 2 ? "Cleaned" : "Clean junk";
                font-size: 18px;
                font-weight: 600;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            if root.stage == 0: Button {
                text: "Look again";
                enabled: !root.busy;
                clicked => {
                    root.again();
                }
            }
            Button {
                text: "Close";
                clicked => {
                    root.close();
                }
            }
        }

        // The list.
        if root.stage == 0: VerticalLayout {
            vertical-stretch: 1;
            // What Clean frees, with the button beside it.
            Rectangle {
                height: card.preferred-height + 24px;
                Card {
                    x: 12px;
                    y: 0;
                    width: parent.width - 24px;
                    height: parent.height - 12px;
                    card := HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: root.busy && root.headline == "" ? "Looking…" : root.headline;
                                font-size: root.compact ? 22px : 26px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }

                            Text {
                                text: root.summary;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Ticked caches and temporary files are deleted; \"check first\" rules go to the quarantine, where Put back restores them. Nothing happens until you confirm.";
                                font-size: 11px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: root.clean-label;
                                primary: true;
                                enabled: root.can-clean;
                                clicked => {
                                    root.clean();
                                }
                            }
                        }
                    }
                }
            }

            // Sized like the home screen's list; see HomePane.
            scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: max(column.preferred-height, end.y + 10px);
                column := VerticalLayout {
                    y: 0;
                    width: scroll.visible-width;
                    height: self.preferred-height * 2 + 1000px;
                    alignment: start;
                    padding: 10px;
                    padding-top: 0;
                    padding-bottom: 10px + root.bottom-inset;
                    for row in root.rows: VerticalLayout {
                        if row.kind == 0: VerticalLayout {
                            padding-top: 14px;
                            padding-bottom: 6px;
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: row.title;
                                    font-size: 15px;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: row.detail;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            if row.subtitle != "": Text {
                                text: row.subtitle;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                        }

                        // A rule with its tick box, or (4) one cleaned with
                        // the system's own tools, with its buttons instead.
                        if row.kind == 1 || row.kind == 4: Rectangle {
                            height: rule.preferred-height + 10px;
                            border-radius: 6px;
                            background: rule-touch.pressed ? Theme.pressed : rule-touch.has-hover ? Palette.alternate-background : transparent;
                            rule-touch := TouchArea {
                                clicked => {
                                    root.expand(row.id);
                                }
                            }

                            rule := HorizontalLayout {
                                y: 5px;
                                padding-left: row.kind == 4 ? 12px : 0px;
                                padding-right: 8px;
                                spacing: 8px;
                                if row.kind == 1: Tick {
                                    checked: row.ticked;
                                    enabled: row.enabled;
                                    toggled => {
                                        root.toggle(row.id);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: row.title;
                                            wrap: word-wrap;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                            color: row.enabled || row.kind == 4 ? Palette.foreground : Theme.dim;
                                        }

                                        if row.badge != "": Badge {
                                            text: row.badge;
                                            warn: true;
                                        }
                                        if root.compact: Text {
                                            text: row.detail;
                                            font-size: 12px;
                                            color: Theme.dim;
                                        }
                                    }

                                    Text {
                                        text: row.subtitle;
                                        wrap: word-wrap;
                                        font-size: 11px;
                                        color: Theme.dim;
                                    }

                                    if root.compact && (row.action != "" || row.second != ""): HorizontalLayout {
                                        padding-top: 4px;
                                        spacing: 8px;
                                        alignment: start;
                                        if row.action != "": Button {
                                            text: row.action;
                                            clicked => {
                                                root.tool(row.id);
                                            }
                                        }
                                        if row.second != "": Button {
                                            text: row.second;
                                            clicked => {
                                                root.command(row.id);
                                            }
                                        }
                                    }
                                }

                                if !root.compact: Text {
                                    text: row.detail;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                }
                                if !root.compact && row.action != "": VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: row.action;
                                        clicked => {
                                            root.tool(row.id);
                                        }
                                    }
                                }
                                if !root.compact && row.second != "": VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: row.second;
                                        clicked => {
                                            root.command(row.id);
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Chevron {
                                        expanded: row.open;
                                        tint: Theme.dim;
                                    }
                                }
                            }
                        }

                        if row.kind == 2: Rectangle {
                            height: 30px;
                            HorizontalLayout {
                                padding-left: 44px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: row.title;
                                    font-size: 12px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: row.id < 0 ? Theme.dim : Palette.foreground;
                                }

                                // Leftovers: the program the path belonged to.
                                if row.subtitle != "": Text {
                                    text: row.subtitle;
                                    font-size: 12px;
                                    color: Theme.dim;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    max-width: 220px;
                                }

                                Text {
                                    text: row.detail;
                                    font-size: 12px;
                                    color: Theme.dim;
                                    vertical-alignment: center;
                                }

                                if row.action != "": Button {
                                    text: row.action;
                                    clicked => {
                                        root.show(row.id);
                                    }
                                }
                            }
                        }

                        if row.kind == 3: Rectangle {
                            height: note.preferred-height + 16px;
                            border-radius: 6px;
                            background: Palette.alternate-background;
                            note := VerticalLayout {
                                y: 8px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 2px;
                                Text {
                                    text: row.title;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: row.subtitle;
                                    wrap: word-wrap;
                                    font-size: 12px;
                                    color: Theme.dim;
                                }
                            }
                        }

                        // A tool rule's command: copy it, or run it.
                        if row.kind == 5: HorizontalLayout {
                            padding-left: 12px;
                            padding-bottom: 8px;
                            Rectangle {
                                height: command.preferred-height + 20px;
                                border-radius: 6px;
                                background: Palette.alternate-background;
                                command := VerticalLayout {
                                    y: 10px;
                                    height: self.preferred-height;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            border-radius: 4px;
                                            background: Palette.background;
                                            height: shown.preferred-height + 12px;
                                            shown := TextInput {
                                                x: 8px;
                                                width: parent.width - 16px;
                                                text: row.title;
                                                read-only: true;
                                                single-line: false;
                                                wrap: word-wrap;
                                                font-family: "monospace";
                                                font-size: 12px;
                                                vertical-alignment: center;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: "Copy";
                                                clicked => {
                                                    shown.select-all();
                                                    shown.copy();
                                                    shown.clear-selection();
                                                    self.text = "Copied";
                                                }
                                            }
                                        }

                                        if row.action != "": VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: row.action;
                                                primary: true;
                                                enabled: row.enabled;
                                                clicked => {
                                                    root.run(row.id);
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: row.subtitle;
                                        font-size: 12px;
                                        color: Theme.dim;
                                        wrap: word-wrap;
                                    }

                                    if row.detail != "": Text {
                                        text: row.detail;
                                        font-family: "monospace";
                                        font-size: 11px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }

                    end := Rectangle {
                        height: 0px;
                    }
                }
            }
        }

        // Cleaning, then what it did: the bar or the big line, and a row
        // per rule.
        if root.stage != 0: VerticalLayout {
            vertical-stretch: 1;
            padding: 12px;
            padding-top: 0;
            padding-bottom: 12px + root.bottom-inset;
            spacing: 12px;
            Card {
                height: head.preferred-height + 28px;
                head := VerticalLayout {
                    y: 14px;
                    height: self.preferred-height;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text {
                        text: root.stage == 1 ? (root.stopping ? "Stopping after this one…" : "Cleaning…") : root.result-title;
                        font-size: root.compact ? 22px : 26px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.stage == 1: SizeBar {
                        fraction: root.fraction;
                        height: 10px;
                    }
                    Text {
                        text: root.stage == 1 ? root.progress-line : root.result-text;
                        font-size: 12px;
                        color: Theme.dim;
                        wrap: word-wrap;
                    }
                }
            }

            steps-scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                VerticalLayout {
                    width: steps-scroll.visible-width;
                    alignment: start;
                    spacing: 2px;
                    for step in root.steps: JunkStepRow {
                        step: step;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if root.stage == 1: Button {
                    text: root.stopping ? "Stopping…" : "Stop";
                    enabled: !root.stopping;
                    clicked => {
                        root.stop();
                    }
                }
                if root.stage == 2 && root.has-quarantined: Button {
                    text: "Open the quarantine";
                    clicked => {
                        root.open-quarantine();
                    }
                }
                if root.stage == 2: Button {
                    text: "Done";
                    primary: true;
                    clicked => {
                        root.done();
                    }
                }
            }
        }
    }
}

/// What changed since an earlier scan, with a picker for which one.
component ChangesPane inherits VerticalLayout {
    in property <[string]> scans;
    in-out property <int> scan-index;
    in property <[CleanRow]> rows;
    in property <int> selected-id;
    callback select(int);
    callback compare(int);

    if root.scans.length > 0: HorizontalLayout {
        padding: 8px;
        padding-bottom: 0;
        spacing: 8px;
        Text {
            text: "Compared with the scan from";
            vertical-alignment: center;
            color: Theme.dim;
        }

        ComboBox {
            model: root.scans;
            current-index <=> root.scan-index;
            horizontal-stretch: 1;
            selected => {
                root.compare(self.current-index);
            }
        }
    }
    CleanupPane {
        rows: root.rows;
        selected-id: root.selected-id;
        select(id) => {
            root.select(id);
        }
    }
}


/// A row of options, one of them chosen.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed();

    width: choices.preferred-width;
    height: 30px;
    border-radius: 15px;
    background: Palette.background.transparentize(8%);
    border-width: 1px;
    border-color: Palette.border;
    choices := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: choice := Rectangle {
            property <bool> on: i == root.current;
            border-radius: 12px;
            background: self.on ? Palette.accent-background : transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: option;
                    font-size: 12px;
                    vertical-alignment: center;
                    color: choice.on ? Palette.accent-foreground : Palette.foreground;
                }
            }

            TouchArea {
                clicked => {
                    root.current = i;
                    root.changed();
                }
            }
        }
    }
}

/// Size by file type, by year changed, or by size. Tapping a row lists its
/// files.
component TypesPane inherits Rectangle {
    in property <[TypeRow]> types;
    in-out property <int> view;
    callback pick(string);
    callback view-changed();

    VerticalLayout {
        HorizontalLayout {
            padding: 6px;
            alignment: start;
            Segmented {
                options: ["Types", "Age", "Size"];
                current <=> root.view;
                changed => {
                    root.view-changed();
                }
            }
        }
        ListView {
            for t in root.types: Rectangle {
                height: 36px;
                background: type-touch.has-hover ? Palette.alternate-background : transparent;
                type-touch := TouchArea {
                    clicked => {
                        root.pick(t.key);
                    }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Rectangle {
                        width: 12px;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 3px;
                            background: t.color;
                        }
                    }

                    Text {
                        text: t.label;
                        width: 110px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: t.files;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Theme.dim;
                        font-size: 12px;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 80px;
                        SizeBar {
                            width: 100%;
                            fraction: t.fraction;
                            fill: t.color;
                        }
                    }

                    Text {
                        text: t.size;
                        width: 70px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component Legend inherits HorizontalLayout {
    in property <color> swatch;
    in property <string> text;
    spacing: 6px;
    Rectangle {
        width: 10px;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: root.swatch;
        }
    }

    Text {
        text: root.text;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

/// Drives to scan, and on Android how the whole device's storage divides up
/// between apps, files and the system, with every app by size.
component HomePane inherits Rectangle {
    in property <[HomeRow]> rows;
    in-out property <length> scroll-y;
    in property <length> card-height;
    in property <[BubbleItem]> bubbles;
    callback choose(string);
    callback open-app(string);
    callback action(string);
    callback bubble(string);
    callback bubbles-resized(length, length);
    callback choose-option(string, int);

    // A plain scrolling layout rather than a ListView: the list view keeps
    // a reused row's old height when its wrapped text changes, so rows would
    // overlap. The home screen has at most a few hundred rows.
    //
    // The scroll height comes from where the empty `end` marker lands, not
    // from the layout's preferred height: Slint measures wrapped text as one
    // line there, which left the last rows out of reach. The layout itself
    // gets room to spare and keeps its rows at the top.
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(column.preferred-height, end.y + 12px);
        content-y <=> root.scroll-y;
        column := VerticalLayout {
            y: 0;
            width: scroll.visible-width;
            height: self.preferred-height * 2 + 1000px;
            alignment: start;
            padding: 16px;
            padding-bottom: 0;
            for row in root.rows: Rectangle {
                content := VerticalLayout {
                    padding-bottom: row.kind == 3 || row.kind == 5 ? 2px : 10px;

                    if row.kind == 0: Card {
                        height: root.card-height + (row.tags != "" ? 16px : 0);
                        background: drive-touch.pressed ? Theme.pressed : drive-touch.has-hover ? Palette.alternate-background : Palette.control-background;
                        drive-touch := TouchArea {
                            clicked => {
                                root.choose(row.key);
                            }
                        }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: row.title;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: row.detail;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    color: Theme.dim;
                                    font-size: 12px;
                                }
                            }

                            SizeBar {
                                fraction: row.fraction;
                            }

                            Text {
                                text: row.subtitle;
                                font-size: 11px;
                                color: Theme.dim;
                                overflow: elide;
                            }

                            if row.tags != "": Text {
                                text: row.tags;
                                font-size: 11px;
                                color: row.warn ? Theme.warn : Theme.dim;
                                overflow: elide;
                            }
                        }
                    }

                    if row.kind == 7: VerticalLayout {
                        spacing: 6px;
                        if row.title != "": HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: row.title;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            if row.action != "": Button {
                                text: row.action;
                                clicked => {
                                    root.action(row.key);
                                }
                            }
                        }
                        Text {
                            text: row.subtitle;
                            font-size: 12px;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }

                        BubblePane {
                            height: min(root.width - 32px, 520px);
                            border-radius: 8px;
                            bubbles: root.bubbles;
                            selected-id: -2;
                            select(id, key) => {
                                root.bubble(key);
                            }
                            resized(w, h) => {
                                root.bubbles-resized(w, h);
                            }
                        }
                    }

                    if row.kind == 6: Card {
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: row.title;
                                font-weight: 600;
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: 4px;
                                background: Theme.track;
                                clip: true;
                                Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 1000;
                                    viewbox-height: 100;
                                    commands: row.chart-used;
                                    fill: Theme.system;
                                }

                                Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 1000;
                                    viewbox-height: 100;
                                    commands: row.chart-files;
                                    fill: Theme.files;
                                }

                                Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 1000;
                                    viewbox-height: 100;
                                    commands: row.chart-apps;
                                    fill: Theme.apps;
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: row.chart-start;
                                    font-size: 11px;
                                    color: Theme.dim;
                                }

                                Text {
                                    text: row.chart-end;
                                    font-size: 11px;
                                    color: Theme.dim;
                                    horizontal-alignment: right;
                                    horizontal-stretch: 1;
                                }
                            }

                            Text {
                                text: row.subtitle;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if row.kind == 1: VerticalLayout {
                        padding-top: 8px;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: row.title;
                                font-size: 18px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }

                            if row.action != "": Button {
                                text: row.action;
                                clicked => {
                                    root.action(row.key);
                                }
                            }
                        }

                        if row.subtitle != "": Text {
                            text: row.subtitle;
                            font-size: 12px;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }
                    }

                    if row.kind == 2: Card {
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            Text {
                                text: row.title;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                height: 14px;
                                border-radius: 4px;
                                background: Theme.track;
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * row.apps;
                                    background: Theme.apps;
                                }

                                Rectangle {
                                    x: parent.width * row.apps;
                                    width: parent.width * row.files;
                                    background: Theme.files;
                                }

                                Rectangle {
                                    x: parent.width * (row.apps + row.files);
                                    width: parent.width * row.system;
                                    background: Theme.system;
                                }
                            }

                            GridLayout {
                                spacing: 8px;
                                Row {
                                    Legend {
                                        swatch: Theme.apps;
                                        text: row.apps-label;
                                    }

                                    Legend {
                                        swatch: Theme.files;
                                        text: row.files-label;
                                    }
                                }

                                Row {
                                    Legend {
                                        swatch: Theme.system;
                                        text: row.system-label;
                                    }

                                    Legend {
                                        swatch: Theme.track;
                                        text: row.free-label;
                                    }
                                }
                            }

                            if row.subtitle != "": Text {
                                text: row.subtitle;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if row.kind == 3: Rectangle {
                        height: row.tags != "" ? 68px : 56px;
                        border-radius: 6px;
                        background: app-touch.pressed ? Theme.pressed : app-touch.has-hover ? Palette.alternate-background : transparent;
                        app-touch := TouchArea {
                            clicked => {
                                root.open-app(row.key);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: row.title;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: row.subtitle;
                                    font-size: 11px;
                                    color: Theme.dim;
                                    overflow: elide;
                                }

                                if row.tags != "": Text {
                                    text: row.tags;
                                    font-size: 11px;
                                    color: row.warn ? Theme.warn : Theme.dim;
                                    overflow: elide;
                                }
                            }

                            // Removed apps have no size now.
                            if row.detail != "": Rectangle {
                                width: 56px;
                                SizeBar {
                                    width: 100%;
                                    fraction: row.fraction;
                                    fill: Theme.apps;
                                }
                            }

                            if row.detail != "": Text {
                                text: row.detail;
                                width: 72px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if row.kind == 5: Rectangle {
                        height: 48px;
                        border-radius: 6px;
                        background: group-touch.pressed ? Theme.pressed : group-touch.has-hover ? Palette.alternate-background : transparent;
                        group-touch := TouchArea {
                            clicked => {
                                root.action(row.key);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text {
                                text: row.title;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Text {
                                text: row.detail;
                                font-size: 12px;
                                color: Theme.dim;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "›";
                                color: Theme.dim;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if row.kind == 8: VerticalLayout {
                        spacing: 8px;
                        padding-bottom: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: back-touch.pressed ? Theme.pressed : back-touch.has-hover ? Palette.alternate-background : transparent;
                                back-touch := TouchArea {
                                    clicked => {
                                        // `home::BACK`
                                        root.action("back");
                                    }
                                }

                                // An arrow pointing left.
                                Path {
                                    width: 18px;
                                    height: 18px;
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    commands: "M 9 3 L 3 9 L 9 15 M 3 9 L 16 9";
                                    stroke: Palette.foreground;
                                    stroke-width: 2px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: row.title;
                                    font-size: 20px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: row.detail;
                                    font-size: 12px;
                                    color: Theme.dim;
                                }
                            }

                            if row.action != "": VerticalLayout {
                                alignment: center;
                                Button {
                                    text: row.action;
                                    clicked => {
                                        root.action(row.key);
                                    }
                                }
                            }
                        }

                        Text {
                            text: row.subtitle;
                            font-size: 12px;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }
                    }

                    if row.kind == 4: Card {
                        background: notice-touch.has-hover ? Palette.control-background : Palette.alternate-background;
                        notice-touch := TouchArea {
                            enabled: row.open-key != "";
                            mouse-cursor: row.open-key != "" ? pointer : default;
                            clicked => {
                                root.action(row.open-key);
                            }
                        }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: row.title;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }

                                if row.open-key != "": Text {
                                    text: "Open ›";
                                    font-size: 12px;
                                    color: Palette.accent-background;
                                    vertical-alignment: center;
                                }
                            }

                            if row.subtitle != "": Text {
                                text: row.subtitle;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                            if row.action != "": HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Button {
                                    text: row.action;
                                    primary: true;
                                    clicked => {
                                        root.action(row.key);
                                    }
                                }

                                if row.action2 != "": Button {
                                    text: row.action2;
                                    clicked => {
                                        root.action(row.key2);
                                    }
                                }
                            }
                        }
                    }

                    if row.kind == 9: Card {
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: row.title;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }

                                if row.subtitle != "": Text {
                                    text: row.subtitle;
                                    font-size: 12px;
                                    color: Theme.dim;
                                    wrap: word-wrap;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                ComboBox {
                                    min-width: 150px;
                                    model: row.choices;
                                    current-index: row.chosen;
                                    selected => {
                                        root.choose-option(row.key, self.current-index);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            end := Rectangle {
                height: 0px;
            }
        }
    }
}

component ScanningPane inherits Rectangle {
    in property <string> title;
    in property <string> counts;
    in property <string> current;
    callback cancel();

    VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Spinner {
                indeterminate: true;
                width: 48px;
                height: 48px;
            }
        }

        Text {
            text: root.title;
            font-size: 18px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.counts;
            horizontal-alignment: center;
        }

        Text {
            text: root.current;
            horizontal-alignment: center;
            font-size: 11px;
            color: Theme.dim;
            overflow: elide;
        }

        HorizontalLayout {
            alignment: center;
            Button {
                text: "Cancel";
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

/// The places of the app, down the left of a wide window.
component Sidebar inherits Rectangle {
    in property <[NavItem]> items;
    in property <string> current;
    in property <length> top-inset;
    callback picked(string);

    width: 188px;
    background: Palette.alternate-background;
    VerticalLayout {
        padding: 10px;
        padding-top: 14px + root.top-inset;
        spacing: 2px;
        alignment: start;
        Text {
            text: "FreeSize";
            font-size: 18px;
            font-weight: 700;
            height: 40px;
            vertical-alignment: center;
            x: 10px;
        }

        for item in root.items: Rectangle {
            height: 40px;
            border-radius: 8px;
            background: item.key == root.current ? Palette.accent-background.transparentize(80%) : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.pressed.transparentize(50%) : transparent;
            touch := TouchArea {
                clicked => {
                    root.picked(item.key);
                }
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: item.label;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    font-weight: item.key == root.current ? 600 : 400;
                    color: item.key == root.current ? Palette.accent-background : Palette.foreground;
                    overflow: elide;
                }

                if item.badge != "": VerticalLayout {
                    alignment: center;
                    Badge {
                        text: item.badge;
                        accent: true;
                    }
                }
            }
        }
    }
}

/// The places of the app, along the bottom of a phone's screen.
component BottomBar inherits Rectangle {
    in property <[NavItem]> items;
    in property <string> current;
    in property <length> bottom-inset;
    callback picked(string);

    height: 56px + root.bottom-inset;
    background: Palette.alternate-background;
    Rectangle {
        y: 0;
        height: 1px;
        background: Palette.border;
    }

    HorizontalLayout {
        padding-bottom: root.bottom-inset;
        for item in root.items: Rectangle {
            horizontal-stretch: 1;
            background: touch.pressed ? Theme.pressed : transparent;
            touch := TouchArea {
                clicked => {
                    root.picked(item.key);
                }
            }

            Rectangle {
                y: 6px;
                width: min(parent.width - 8px, 72px);
                height: 4px;
                border-radius: 2px;
                background: item.key == root.current ? Palette.accent-background : transparent;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: item.label;
                    horizontal-alignment: center;
                    font-size: 13px;
                    font-weight: item.key == root.current ? 600 : 400;
                    color: item.key == root.current ? Palette.accent-background : Palette.foreground;
                    overflow: elide;
                }

                Text {
                    text: item.badge;
                    horizontal-alignment: center;
                    font-size: 10px;
                    color: Theme.dim;
                    height: item.badge != "" ? self.preferred-height : 0px;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: root.window-title;
    in property <string> window-title: "FreeSize";
    icon: @image-url("icon.png");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 320px;
    min-height: 420px;
    background: Palette.background;

    in-out property <string> path;
    in property <bool> scanning;
    in property <bool> has-tree;
    in property <string> status;
    in property <string> scan-title;
    in property <string> scan-counts;
    in property <string> scan-current;
    in property <[HomeRow]> home-rows;
    in property <[TreeRow]> tree-rows;
    in property <[MapRect]> map-rects;
    in property <[FileRow]> largest-files;
    in property <[TypeRow]> file-types;
    in property <[CleanRow]> cleanup-rows;
    in property <[CleanSection]> cleanup-sections;
    in property <string> cleanup-summary;
    in property <string> cleanup-page;
    in property <string> cleanup-page-title;
    in property <string> cleanup-page-blurb;
    in property <string> cleanup-page-size;
    in property <string> cleanup-page-action;
    in property <string> cleanup-page-picked;
    in property <bool> cleanup-page-warn;
    in property <[string]> cleanup-filters;
    in-out property <int> cleanup-filter-index;
    in property <string> cleanup-pick-label;
    in property <bool> cleanup-any-picked;
    in property <[PhotoSet]> cleanup-photo-sets;
    in property <[Crumb]> crumbs;
    in property <string> focus-size;
    in property <[BubbleItem]> bubbles;
    in-out property <bool> bubbles-view;
    in property <[BubbleItem]> app-bubbles;
    in property <string> files-filter;
    in property <bool> in-basket;
    in property <int> basket-count;
    in property <string> basket-summary;
    in property <[BasketRow]> basket-rows;
    in property <bool> basket-open;
    /// What the last move was, while it can be put back.
    in property <string> put-back-label;
    /// Places to move the basket to, while choosing one (phones).
    in property <[string]> move-targets;
    /// What the Types tab shows: 0 types, 1 ages, 2 sizes.
    in-out property <int> types-view;
    in property <[string]> change-scans;
    in-out property <int> change-scan-index;
    in property <[CleanRow]> change-rows;
    // The Clean junk screen.
    in property <bool> junk-open;
    in property <[JunkRow]> junk-rows;
    in property <string> junk-summary;
    in property <bool> junk-busy;
    in property <string> junk-clean-label: "Clean";
    in property <bool> junk-can-clean;
    in property <int> junk-stage;
    in property <string> junk-headline;
    in property <[JunkStep]> junk-steps;
    in property <float> junk-fraction;
    in property <string> junk-progress-line;
    in property <bool> junk-stopping;
    in property <string> junk-result-title;
    in property <string> junk-result-text;
    in property <bool> junk-has-quarantined;

    // A quarantined batch's page.
    in property <bool> qv-open;
    in property <[QuarantineRow]> qv-rows;
    in property <string> qv-title;
    in property <string> qv-subtitle;
    in property <string> qv-crumbs;
    in property <string> qv-picked;
    in property <bool> qv-busy;

    // Putting back over something new: keep both, replace or skip.
    in property <bool> conflict-open;
    in property <string> conflict-text;
    /// The selected tab of each layout's tabs.
    in-out property <int> wide-tab;
    in-out property <int> compact-tab;
    in property <int> selected-id: -1;
    in property <string> selected-title;
    in property <string> selected-detail;
    in property <bool> can-delete;
    in property <bool> can-go-up;
    in property <bool> can-reveal;
    in property <bool> can-open;
    in property <bool> can-browse;
    in property <string> delete-label: "Move to Trash";
    in property <bool> needs-permission;
    in property <bool> confirm-open;
    in property <string> confirm-text;
    in property <bool> sheet-open;
    in property <string> sheet-title;
    in property <string> sheet-subtitle;
    in property <[string]> sheet-facts;
    in property <string> sheet-note;
    in property <[SheetAction]> sheet-actions;
    // Connecting to a FreeSize Hub.
    in property <bool> hub-connect-open;
    in-out property <string> hub-link;
    in-out property <string> hub-code;
    in property <string> hub-connect-status;
    in property <bool> hub-busy;
    in property <string> hub-confirm-fingerprint;
    // A request from the Hub to approve.
    in property <bool> approval-open;
    in property <string> approval-title;
    in property <[string]> approval-lines;
    in property <[int]> approval-minutes;
    in-out property <bool> size-on-disk: true;
    in-out property <length> tree-scroll;
    /// A group of apps is open as its own page on the home screen.
    in property <bool> home-page-open;
    /// The places in the sidebar or tab bar, and the one shown.
    in property <[NavItem]> nav-items;
    in property <string> section: "home";
    /// The button beside Scan for a scan with more rights; empty for none.
    in property <string> admin-label;
    /// A scan, or its results, fill the window (the drive list doesn't).
    out property <bool> in-scan: root.section == "home" && (root.scanning || root.has-tree);
    out property <bool> bottom-bar: root.compact && !root.in-scan;
    in-out property <length> home-scroll;

    // Set from `changed width` rather than bound to it: a binding would make
    // the window's size depend on itself through the layout.
    out property <bool> compact;
    out property <length> tree-row-height: root.compact ? 40px : 28px;

    init => {
        root.compact = root.width < 760px;
    }
    changed width => {
        root.compact = root.width < 760px;
    }

    callback start-scan(string);
    callback cancel-scan();
    callback browse();
    callback show-locations();
    callback open-app(string);
    callback home-action(string);
    callback toggle-row(int);
    callback select-node(int, bool);
    callback map-resized(length, length);
    callback bubbles-resized(length, length);
    callback map-view-changed();
    callback app-bubble(string);
    callback type-picked(string);
    callback clear-files-filter();
    callback collect-listed();
    callback collect();
    callback export();
    callback basket-review();
    callback basket-remove(int);
    callback basket-delete-all();
    callback basket-move-all();
    callback basket-clear();
    callback basket-close();
    callback put-back();
    callback move-target(int);
    callback types-view-changed();
    callback compare-scan(int);
    callback app-bubbles-resized(length, length);
    callback size-mode-changed();
    callback go-up();
    callback reveal-selected();
    callback open-selected();
    callback delete-requested();
    callback delete-confirmed();
    callback delete-cancelled();
    callback grant-permission();
    callback sheet-action(string);
    callback cleanup-action(string);
    callback cleanup-open(string);
    callback cleanup-open-item(int);
    callback cleanup-check(int);
    callback cleanup-group(int);
    callback cleanup-pick(bool);
    callback cleanup-filter(int);
    callback junk-close();
    callback junk-toggle(int);
    callback junk-expand(int);
    callback junk-show(int);
    callback junk-tool(int);
    callback junk-clean();
    callback junk-again();
    callback junk-command(int);
    callback junk-run(int);
    callback junk-stop();
    callback junk-done();
    callback junk-quarantine();
    callback qv-back();
    callback qv-toggle(int);
    callback qv-open-item(int);
    callback qv-reveal(int);
    callback qv-restore(int);
    callback qv-delete(int);
    callback qv-restore-chosen();
    callback qv-delete-chosen();
    /// 0 keep both, 1 replace, 2 skip; -1 cancel.
    callback conflict-chosen(int);
    callback hub-connect();
    callback hub-confirm();
    callback hub-connect-cancel();
    callback section-picked(string);
    callback home-choice(string, int);
    callback scan-as-admin();
    /// -1 to deny, 0 to approve once, else minutes of the grant.
    callback approval-answer(int);
    callback approval-later();

    forward-focus: keys;

    // Android's Back gesture (and Escape on desktop) steps back through the
    // app before leaving it: close the dialog, stop the scan, zoom out, then
    // return to the drive list, or from a group's page to the home screen.
    // Unhandled, Back closes the app.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text != Key.Back && event.text != Key.Escape) {
                return reject;
            }
            if (root.approval-open) {
                root.approval-later();
                return accept;
            }
            if (root.hub-connect-open) {
                root.hub-connect-cancel();
                return accept;
            }
            if (root.sheet-open) {
                root.sheet-action("close");
                return accept;
            }
            if (root.basket-open) {
                root.basket-close();
                return accept;
            }
            if (root.confirm-open) {
                root.delete-cancelled();
                return accept;
            }
            if (root.junk-open) {
                root.junk-close();
                return accept;
            }
            if (root.scanning && root.section == "home") {
                root.cancel-scan();
                return accept;
            }
            if (root.in-scan && root.can-go-up) {
                root.go-up();
                return accept;
            }
            if (root.in-scan && event.text == Key.Back) {
                root.show-locations();
                return accept;
            }
            if (root.home-page-open) {
                // `home::BACK`
                root.home-action("back");
                return accept;
            }
            if (root.section != "home" && event.text == Key.Back) {
                root.section-picked("home");
                return accept;
            }
            reject
        }

        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            if !root.compact: Sidebar {
                items: root.nav-items;
                current: root.section;
                top-inset: root.safe-area-insets.top;
                picked(key) => {
                    root.section-picked(key);
                }
            }
            if !root.compact: Rectangle {
                width: 1px;
                background: Palette.border;
            }

        VerticalLayout {
            horizontal-stretch: 1;
            // Room for the status bar where the toolbar isn't shown.
            if root.section != "home": Rectangle {
                height: root.safe-area-insets.top;
            }
            // Toolbar, where drives are scanned.
            if root.section == "home": Rectangle {
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 8px;
                    padding-top: 8px + root.safe-area-insets.top;
                    spacing: 6px;
                    if root.has-tree && !root.scanning: Button {
                        text: "Drives";
                        clicked => {
                            root.show-locations();
                        }
                    }
                    LineEdit {
                        text <=> root.path;
                        placeholder-text: "Folder to scan";
                        horizontal-stretch: 1;
                        enabled: !root.scanning;
                        accepted(text) => {
                            root.start-scan(text);
                        }
                    }

                    if root.can-browse: Button {
                        text: "Browse…";
                        enabled: !root.scanning;
                        clicked => {
                            root.browse();
                        }
                    }
                    Button {
                        text: root.scanning ? "Cancel" : "Scan";
                        primary: !root.scanning;
                        clicked => {
                            if (root.scanning) {
                                root.cancel-scan();
                            } else {
                                root.start-scan(root.path);
                            }
                        }
                    }
                    if root.admin-label != "" && !root.scanning && !root.compact: Button {
                        text: root.admin-label;
                        clicked => {
                            root.scan-as-admin();
                        }
                    }
                }
            }
            if root.section == "home" && root.admin-label != "" && !root.scanning && root.compact: Rectangle {
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 8px;
                    padding-top: 0;
                    alignment: end;
                    Button {
                        text: root.admin-label;
                        clicked => {
                            root.scan-as-admin();
                        }
                    }
                }
            }

            // Android storage permission
            if root.needs-permission: Rectangle {
                background: #f0b42933;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;
                    Text {
                        text: "FreeSize needs “All files access” to see everything on your storage.";
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Grant access";
                        primary: true;
                        clicked => {
                            root.grant-permission();
                        }
                    }
                }
            }

            // Status line
            if root.in-scan || root.section == "home" || root.status != "": HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                Text {
                    text: root.status;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    color: Theme.dim;
                    font-size: 12px;
                }

                if root.in-scan && root.has-tree: Button {
                    text: "Export";
                    clicked => {
                        root.export();
                    }
                }
                if root.in-scan && root.has-tree: ComboBox {
                    width: 150px;
                    model: ["Size on disk", "File size"];
                    current-index: 0;
                    selected => {
                        root.size-on-disk = self.current-index == 0;
                        root.size-mode-changed();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // Content
            if root.scanning && root.section == "home": ScanningPane {
                vertical-stretch: 1;
                title: root.scan-title;
                counts: root.scan-counts;
                current: root.scan-current;
                cancel => {
                    root.cancel-scan();
                }
            }
            if !root.in-scan: HomePane {
                vertical-stretch: 1;
                rows: root.home-rows;
                scroll-y <=> root.home-scroll;
                card-height: root.compact ? 86px : 78px;
                bubbles: root.app-bubbles;
                bubble(key) => {
                    root.app-bubble(key);
                }
                bubbles-resized(w, h) => {
                    root.app-bubbles-resized(w, h);
                }
                choose-option(key, index) => {
                    root.home-choice(key, index);
                }
                choose(path) => {
                    root.path = path;
                    root.start-scan(path);
                }
                open-app(package) => {
                    root.open-app(package);
                }
                action(id) => {
                    root.home-action(id);
                }
            }
            if root.in-scan && !root.scanning && !root.compact: HorizontalLayout {
                vertical-stretch: 1;
                TreePane {
                    horizontal-stretch: 45;
                    rows: root.tree-rows;
                    selected-id: root.selected-id;
                    row-height: root.tree-row-height;
                    compact: root.compact;
                    scroll-y <=> root.tree-scroll;
                    toggle(index) => {
                        root.toggle-row(index);
                    }
                    select(id) => {
                        root.select-node(id, false);
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Palette.border;
                }

                VerticalLayout {
                    horizontal-stretch: 55;
                    Breadcrumb {
                        crumbs: root.crumbs;
                        size: root.focus-size;
                        select(id) => {
                            root.select-node(id, true);
                        }
                    }

                    TabWidget {
                        current-index <=> root.wide-tab;
                        Tab {
                            title: "Map";
                            MapView {
                                rects: root.map-rects;
                                bubbles: root.bubbles;
                                selected-id: root.selected-id;
                                bubbles-view <=> root.bubbles-view;
                                select(id) => {
                                    root.select-node(id, true);
                                }
                                map-resized(w, h) => {
                                    root.map-resized(w, h);
                                }
                                bubbles-resized(w, h) => {
                                    root.bubbles-resized(w, h);
                                }
                                view-changed => {
                                    root.map-view-changed();
                                }
                            }
                        }

                        Tab {
                            title: "Largest files";
                            LargestPane {
                                files: root.largest-files;
                                selected-id: root.selected-id;
                                filter: root.files-filter;
                                select(id) => {
                                    root.select-node(id, true);
                                }
                                clear-filter => {
                                    root.clear-files-filter();
                                }
                                collect-all => {
                                    root.collect-listed();
                                }
                            }
                        }

                        Tab {
                            title: "File types";
                            TypesPane {
                                types: root.file-types;
                                view <=> root.types-view;
                                pick(key) => {
                                    root.type-picked(key);
                                }
                                view-changed => {
                                    root.types-view-changed();
                                }
                            }
                        }

                        Tab {
                            title: "Clean up";
                            CleanupView {
                                sections: root.cleanup-sections;
                                summary: root.cleanup-summary;
                                page: root.cleanup-page;
                                page-title: root.cleanup-page-title;
                                page-blurb: root.cleanup-page-blurb;
                                page-size: root.cleanup-page-size;
                                page-action: root.cleanup-page-action;
                                page-picked: root.cleanup-page-picked;
                                page-warn: root.cleanup-page-warn;
                                rows: root.cleanup-rows;
                                photo-sets: root.cleanup-photo-sets;
                                filters: root.cleanup-filters;
                                pick-label: root.cleanup-pick-label;
                                any-picked: root.cleanup-any-picked;
                                selected-id: root.selected-id;
                                compact: root.compact;
                                filter-index <=> root.cleanup-filter-index;
                                open(key) => {
                                    root.cleanup-open(key);
                                }
                                back => {
                                    root.cleanup-open("");
                                }
                                action(key) => {
                                    root.cleanup-action(key);
                                }
                                select(id) => {
                                    root.select-node(id, true);
                                }
                                open-item(id) => {
                                    root.cleanup-open-item(id);
                                }
                                check(id) => {
                                    root.cleanup-check(id);
                                }
                                group(index) => {
                                    root.cleanup-group(index);
                                }
                                pick-all => {
                                    root.cleanup-pick(true);
                                }
                                pick-none => {
                                    root.cleanup-pick(false);
                                }
                                filter-changed(index) => {
                                    root.cleanup-filter(index);
                                }
                            }
                        }

                        Tab {
                            title: "Changes";
                            ChangesPane {
                                scans: root.change-scans;
                                scan-index <=> root.change-scan-index;
                                rows: root.change-rows;
                                selected-id: root.selected-id;
                                select(id) => {
                                    root.select-node(id, true);
                                }
                                compare(index) => {
                                    root.compare-scan(index);
                                }
                            }
                        }
                    }
                }
            }
            if root.in-scan && !root.scanning && root.compact: TabWidget {
                vertical-stretch: 1;
                current-index <=> root.compact-tab;
                Tab {
                    title: "Folders";
                    TreePane {
                        rows: root.tree-rows;
                        selected-id: root.selected-id;
                        row-height: root.tree-row-height;
                        compact: root.compact;
                        scroll-y <=> root.tree-scroll;
                        toggle(index) => {
                            root.toggle-row(index);
                        }
                        select(id) => {
                            root.select-node(id, false);
                        }
                    }
                }

                Tab {
                    title: "Map";
                    VerticalLayout {
                        Breadcrumb {
                            crumbs: root.crumbs;
                            size: root.focus-size;
                            select(id) => {
                                root.select-node(id, false);
                            }
                        }

                        MapView {
                            rects: root.map-rects;
                            bubbles: root.bubbles;
                            selected-id: root.selected-id;
                            bubbles-view <=> root.bubbles-view;
                            select(id) => {
                                root.select-node(id, false);
                            }
                            map-resized(w, h) => {
                                root.map-resized(w, h);
                            }
                            bubbles-resized(w, h) => {
                                root.bubbles-resized(w, h);
                            }
                            view-changed => {
                                root.map-view-changed();
                            }
                        }
                    }
                }

                Tab {
                    title: "Files";
                    LargestPane {
                        files: root.largest-files;
                        selected-id: root.selected-id;
                        filter: root.files-filter;
                        select(id) => {
                            root.select-node(id, true);
                        }
                        clear-filter => {
                            root.clear-files-filter();
                        }
                        collect-all => {
                            root.collect-listed();
                        }
                    }
                }

                Tab {
                    title: "Types";
                    TypesPane {
                        types: root.file-types;
                        view <=> root.types-view;
                        pick(key) => {
                            root.type-picked(key);
                        }
                        view-changed => {
                            root.types-view-changed();
                        }
                    }
                }

                Tab {
                    title: "Clean";
                    CleanupView {
                        sections: root.cleanup-sections;
                        summary: root.cleanup-summary;
                        page: root.cleanup-page;
                        page-title: root.cleanup-page-title;
                        page-blurb: root.cleanup-page-blurb;
                        page-size: root.cleanup-page-size;
                        page-action: root.cleanup-page-action;
                        page-picked: root.cleanup-page-picked;
                        page-warn: root.cleanup-page-warn;
                        rows: root.cleanup-rows;
                        photo-sets: root.cleanup-photo-sets;
                        filters: root.cleanup-filters;
                        pick-label: root.cleanup-pick-label;
                        any-picked: root.cleanup-any-picked;
                        selected-id: root.selected-id;
                        compact: root.compact;
                        filter-index <=> root.cleanup-filter-index;
                        open(key) => {
                            root.cleanup-open(key);
                        }
                        back => {
                            root.cleanup-open("");
                        }
                        action(key) => {
                            root.cleanup-action(key);
                        }
                        select(id) => {
                            root.select-node(id, true);
                        }
                        open-item(id) => {
                            root.cleanup-open-item(id);
                        }
                        check(id) => {
                            root.cleanup-check(id);
                        }
                        group(index) => {
                            root.cleanup-group(index);
                        }
                        pick-all => {
                            root.cleanup-pick(true);
                        }
                        pick-none => {
                            root.cleanup-pick(false);
                        }
                        filter-changed(index) => {
                            root.cleanup-filter(index);
                        }
                    }
                }

                Tab {
                    title: "Changes";
                    ChangesPane {
                        scans: root.change-scans;
                        scan-index <=> root.change-scan-index;
                        rows: root.change-rows;
                        selected-id: root.selected-id;
                        select(id) => {
                            root.select-node(id, true);
                        }
                        compare(index) => {
                            root.compare-scan(index);
                        }
                    }
                }
            }

            // Basket bar: what's collected, and the last move to put back.
            if root.in-scan && !root.scanning && (root.basket-count > 0 || root.put-back-label != ""): Rectangle {
                background: Palette.accent-background.transparentize(85%);
                HorizontalLayout {
                    padding: 6px;
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: root.basket-count > 0 ? "Selected to remove: " + root.basket-summary : "Moved: " + root.put-back-label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    if root.basket-count > 0: Button {
                        text: "Review…";
                        primary: true;
                        clicked => {
                            root.basket-review();
                        }
                    }
                    if root.basket-count == 0: Button {
                        text: "Put back";
                        clicked => {
                            root.put-back();
                        }
                    }
                }
            }

            // Selection bar
            if root.in-scan && !root.scanning: Rectangle {
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 8px;
                    padding-bottom: 8px + root.safe-area-insets.bottom;
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.selected-title;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.selected-detail;
                            font-size: 11px;
                            color: Theme.dim;
                            overflow: elide;
                        }
                    }

                    Button {
                        text: "Up";
                        enabled: root.can-go-up;
                        clicked => {
                            root.go-up();
                        }
                    }

                    Button {
                        text: "Open";
                        enabled: root.can-open;
                        clicked => {
                            root.open-selected();
                        }
                    }

                    if root.can-reveal && !root.compact: Button {
                        text: "Show in folder";
                        clicked => {
                            root.reveal-selected();
                        }
                    }
                    Button {
                        text: root.in-basket ? "Selected" : "Select";
                        enabled: root.can-delete || root.in-basket;
                        clicked => {
                            root.collect();
                        }
                    }

                    Button {
                        text: "Delete";
                        enabled: root.can-delete;
                        clicked => {
                            root.delete-requested();
                        }
                    }
                }
            }

            if root.bottom-bar: BottomBar {
                items: root.nav-items;
                current: root.section;
                bottom-inset: root.safe-area-insets.bottom;
                picked(key) => {
                    root.section-picked(key);
                }
            }

            // Keep content above the gesture bar when there is no selection
            // bar or tab bar.
            if !root.bottom-bar && (root.scanning || !root.in-scan): Rectangle {
                height: root.safe-area-insets.bottom;
            }
        }
        }
    }

    // Delete confirmation
    // The Clean junk screen, over the whole window.
    if root.junk-open: JunkPane {
        rows: root.junk-rows;
        stage: root.junk-stage;
        headline: root.junk-headline;
        steps: root.junk-steps;
        fraction: root.junk-fraction;
        progress-line: root.junk-progress-line;
        stopping: root.junk-stopping;
        result-title: root.junk-result-title;
        result-text: root.junk-result-text;
        has-quarantined: root.junk-has-quarantined;
        compact: root.compact;
        summary: root.junk-summary;
        busy: root.junk-busy;
        clean-label: root.junk-clean-label;
        can-clean: root.junk-can-clean;
        top-inset: root.safe-area-insets.top;
        bottom-inset: root.safe-area-insets.bottom;
        close => {
            root.junk-close();
        }
        toggle(id) => {
            root.junk-toggle(id);
        }
        expand(id) => {
            root.junk-expand(id);
        }
        show(id) => {
            root.junk-show(id);
        }
        tool(id) => {
            root.junk-tool(id);
        }
        clean => {
            root.junk-clean();
        }
        again => {
            root.junk-again();
        }
        command(id) => {
            root.junk-command(id);
        }
        run(id) => {
            root.junk-run(id);
        }
        stop => {
            root.junk-stop();
        }
        done => {
            root.junk-done();
        }
        open-quarantine => {
            root.junk-quarantine();
        }
    }

    if root.qv-open: QuarantinePane {
        rows: root.qv-rows;
        title: root.qv-title;
        subtitle: root.qv-subtitle;
        crumbs: root.qv-crumbs;
        picked: root.qv-picked;
        busy: root.qv-busy;
        can-reveal: root.can-reveal;
        compact: root.compact;
        top-inset: root.safe-area-insets.top;
        bottom-inset: root.safe-area-insets.bottom;
        back => {
            root.qv-back();
        }
        toggle(id) => {
            root.qv-toggle(id);
        }
        open(id) => {
            root.qv-open-item(id);
        }
        reveal(id) => {
            root.qv-reveal(id);
        }
        restore(id) => {
            root.qv-restore(id);
        }
        delete(id) => {
            root.qv-delete(id);
        }
        restore-chosen => {
            root.qv-restore-chosen();
        }
        delete-chosen => {
            root.qv-delete-chosen();
        }
    }

    if root.conflict-open: Rectangle {
        background: #00000088;
        TouchArea { }

        Rectangle {
            width: min(parent.width - 32px, 480px);
            height: conflict.preferred-height;
            border-radius: 10px;
            background: Palette.background;
            conflict := VerticalLayout {
                padding: 18px;
                spacing: 14px;
                Text {
                    text: root.conflict-text;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.conflict-chosen(-1);
                        }
                    }

                    Button {
                        text: "Skip";
                        clicked => {
                            root.conflict-chosen(2);
                        }
                    }

                    Button {
                        text: "Replace";
                        clicked => {
                            root.conflict-chosen(1);
                        }
                    }

                    Button {
                        text: "Keep both";
                        primary: true;
                        clicked => {
                            root.conflict-chosen(0);
                        }
                    }
                }
            }
        }
    }

    if root.confirm-open: Rectangle {
        background: #00000088;
        TouchArea { }

        Rectangle {
            width: min(420px, parent.width - 32px);
            height: dialog.preferred-height;
            border-radius: 10px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            dialog := VerticalLayout {
                padding: 18px;
                spacing: 16px;
                Text {
                    text: root.confirm-text;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.delete-cancelled();
                        }
                    }

                    Button {
                        text: root.delete-label;
                        primary: true;
                        clicked => {
                            root.delete-confirmed();
                        }
                    }
                }
            }
        }
    }

    // The basket: everything collected, to delete or move at once. A bottom
    // sheet on phones, a centered dialog on wide windows.
    if root.basket-open: Rectangle {
        background: #00000088;
        TouchArea {
            clicked => {
                root.basket-close();
            }
        }

        Rectangle {
            width: root.compact ? parent.width : min(520px, parent.width - 32px);
            height: min(basket-layout.preferred-height, parent.height - root.safe-area-insets.top - 24px);
            y: root.compact ? parent.height - self.height : (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            TouchArea { }

            basket-layout := VerticalLayout {
                padding: 18px;
                padding-bottom: 18px + (root.compact ? root.safe-area-insets.bottom : 0px);
                spacing: 8px;
                Text {
                    text: "Selected to remove";
                    font-size: 18px;
                    font-weight: 600;
                }

                Text {
                    text: root.basket-count > 0 ? root.basket-summary + ". Look them over: Keep takes one off the list. Nothing is deleted until you confirm, and then it goes to the quarantine, where Put back restores it." : "Nothing is selected.";
                    color: Theme.dim;
                    wrap: word-wrap;
                }

                if root.basket-count > 0: ListView {
                    height: min(root.basket-rows.length * 46px, 276px);
                    for row in root.basket-rows: Rectangle {
                        height: 46px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: row.name;
                                    overflow: elide;
                                }

                                Text {
                                    text: row.place;
                                    font-size: 11px;
                                    color: Theme.dim;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: row.size;
                                vertical-alignment: center;
                            }

                            Button {
                                text: "Keep";
                                clicked => {
                                    root.basket-remove(row.id);
                                }
                            }
                        }
                    }
                }
                if root.move-targets.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Move everything to:";
                        font-weight: 600;
                    }

                    for target[i] in root.move-targets: Button {
                        text: target;
                        clicked => {
                            root.move-target(i);
                        }
                    }
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.basket-close();
                        }
                    }
                }
                if root.move-targets.length == 0: VerticalLayout {
                    spacing: 6px;
                    padding-top: 6px;
                    Button {
                        text: "Delete all…";
                        primary: true;
                        enabled: root.basket-count > 0;
                        clicked => {
                            root.basket-delete-all();
                        }
                    }

                    Button {
                        text: "Move all…";
                        enabled: root.basket-count > 0;
                        clicked => {
                            root.basket-move-all();
                        }
                    }

                    if root.put-back-label != "": Button {
                        text: "Put back: " + root.put-back-label;
                        clicked => {
                            root.put-back();
                        }
                    }
                    Button {
                        text: "Clear the selection";
                        enabled: root.basket-count > 0;
                        clicked => {
                            root.basket-clear();
                        }
                    }

                    Button {
                        text: "Close";
                        clicked => {
                            root.basket-close();
                        }
                    }
                }
            }
        }
    }

    // App details: facts and actions for one app. A bottom sheet on phones,
    // a centered dialog on wide windows.
    if root.sheet-open: Rectangle {
        background: #00000088;
        TouchArea {
            clicked => {
                root.sheet-action("close");
            }
        }

        Rectangle {
            width: root.compact ? parent.width : min(480px, parent.width - 32px);
            height: min(sheet-layout.preferred-height, parent.height - root.safe-area-insets.top - 24px);
            y: root.compact ? parent.height - self.height : (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            // Keeps taps on the sheet from closing it.
            TouchArea { }

            Flickable {
                content-width: self.width;
                content-height: sheet-layout.preferred-height;
                sheet-layout := VerticalLayout {
                    width: parent.width;
                    padding: 18px;
                    padding-bottom: 18px + (root.compact ? root.safe-area-insets.bottom : 0px);
                    spacing: 6px;
                    Text {
                        text: root.sheet-title;
                        font-size: 18px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.sheet-subtitle;
                        font-size: 12px;
                        color: Theme.dim;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 4px;
                    }

                    for fact in root.sheet-facts: Text {
                        text: fact;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    if root.sheet-note != "": Rectangle {
                        border-radius: 6px;
                        background: Theme.system.transparentize(80%);
                        height: note.preferred-height;
                        note := VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.sheet-note;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: 6px;
                    }

                    for action in root.sheet-actions: Button {
                        text: action.label;
                        primary: action.primary;
                        clicked => {
                            root.sheet-action(action.id);
                        }
                    }
                }
            }
        }
    }

    // Connecting to a FreeSize Hub: a pairing link, or its address and code.
    if root.hub-connect-open: Rectangle {
        background: #00000088;
        TouchArea { }

        Rectangle {
            width: root.compact ? parent.width : min(480px, parent.width - 32px);
            height: min(connect-layout.preferred-height, parent.height - root.safe-area-insets.top - 24px);
            y: root.compact ? parent.height - self.height : (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            connect-layout := VerticalLayout {
                padding: 18px;
                padding-bottom: 18px + (root.compact ? root.safe-area-insets.bottom : 0px);
                spacing: 10px;
                Text {
                    text: "Connect to a FreeSize Hub";
                    font-size: 18px;
                    font-weight: 600;
                }

                Text {
                    text: "In the Hub's dashboard, choose Pair a device. Paste the link it shows, or type the Hub's address and the code.";
                    font-size: 13px;
                    wrap: word-wrap;
                }

                LineEdit {
                    text <=> root.hub-link;
                    placeholder-text: "Pairing link, or the Hub's address";
                    enabled: !root.hub-busy && root.hub-confirm-fingerprint == "";
                }

                LineEdit {
                    text <=> root.hub-code;
                    placeholder-text: "Code, when typing the address";
                    enabled: !root.hub-busy && root.hub-confirm-fingerprint == "";
                }

                if root.hub-confirm-fingerprint != "": Rectangle {
                    border-radius: 6px;
                    background: Theme.system.transparentize(80%);
                    height: fingerprint-layout.preferred-height;
                    fingerprint-layout := VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Text {
                            text: "This Hub's key is";
                            font-size: 13px;
                        }

                        Text {
                            text: root.hub-confirm-fingerprint;
                            font-size: 17px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Check it matches the dashboard (Settings → This Hub) before connecting.";
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.hub-connect-status != "": Text {
                    text: root.hub-connect-status;
                    font-size: 13px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.hub-connect-cancel();
                        }
                    }

                    Button {
                        text: root.hub-confirm-fingerprint != "" ? "It matches, connect" : "Connect";
                        primary: true;
                        enabled: !root.hub-busy;
                        clicked => {
                            if (root.hub-confirm-fingerprint != "") {
                                root.hub-confirm();
                            } else {
                                root.hub-connect();
                            }
                        }
                    }
                }
            }
        }
    }

    // A request from the Hub: shown in full, nothing happens until it's
    // approved here.
    if root.approval-open: Rectangle {
        background: #00000088;
        TouchArea { }

        Rectangle {
            width: root.compact ? parent.width : min(500px, parent.width - 32px);
            height: min(approval-layout.preferred-height, parent.height - root.safe-area-insets.top - 24px);
            y: root.compact ? parent.height - self.height : (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            approval-layout := VerticalLayout {
                padding: 18px;
                padding-bottom: 18px + (root.compact ? root.safe-area-insets.bottom : 0px);
                spacing: 8px;
                Text {
                    text: root.approval-title;
                    font-size: 18px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Rectangle {
                    border-radius: 6px;
                    background: Palette.alternate-background;
                    height: min(lines-layout.preferred-height, 260px);
                    Flickable {
                        content-height: lines-layout.preferred-height;
                        lines-layout := VerticalLayout {
                            padding: 10px;
                            spacing: 3px;
                            for line[i] in root.approval-lines: Text {
                                text: line;
                                font-size: i == 0 ? 14px : 12px;
                                font-weight: i == 0 ? 600 : 400;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Text {
                    text: "Nothing happens unless you approve. A grant lets the same person do the same kind of thing again without asking, until it runs out.";
                    font-size: 12px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }

                Button {
                    text: "Approve once";
                    primary: true;
                    clicked => {
                        root.approval-answer(0);
                    }
                }

                for minutes in root.approval-minutes: Button {
                    text: "Approve for " + minutes + " minutes";
                    clicked => {
                        root.approval-answer(minutes);
                    }
                }

                Button {
                    text: "Deny";
                    clicked => {
                        root.approval-answer(-1);
                    }
                }

                Button {
                    text: "Not now";
                    clicked => {
                        root.approval-later();
                    }
                }
            }
        }
    }
}
