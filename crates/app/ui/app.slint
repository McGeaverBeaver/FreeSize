import { Button, LineEdit, ComboBox, TabWidget, ListView, Palette, ScrollView, Spinner } from "std-widgets.slint";

export struct TreeRow {
    id: int,
    depth: int,
    name: string,
    size: string,
    percent: string,
    fraction: float,
    expandable: bool,
    expanded: bool,
    is-dir: bool,
    summary: bool,
    note: string,
}

export struct MapRect {
    id: int,
    x: length,
    y: length,
    width: length,
    height: length,
    color: color,
    text-color: color,
    label: string,
    nested: bool,
    /// Icon for the kind of content (see Icons.of), shown when `icon-size`
    /// isn't 0; `app-icon` replaces it when `has-app-icon`.
    icon: int,
    app-icon: image,
    has-app-icon: bool,
    icon-size: length,
    /// A tool can rebuild it: drawn with a green outline.
    ring: bool,
}

/// One circle of the bubble view. `id` is -1 for the bubble standing for
/// the smaller items; the start screen's app bubbles use `key` instead.
export struct BubbleItem {
    id: int,
    key: string,
    x: length,
    y: length,
    r: length,
    color: color,
    text-color: color,
    label: string,
    detail: string,
    /// 0 for the folder's own items, 1 for items drawn inside them.
    depth: int,
    icon: int,
    app-icon: image,
    has-app-icon: bool,
    icon-size: length,
    ring: bool,
    /// Its label sits on a dark pill, over the bubbles inside it.
    pill: bool,
}

/// An item in the basket.
export struct BasketRow {
    id: int,
    name: string,
    place: string,
    size: string,
}

/// One step of the path to the folder shown.
export struct Crumb {
    id: int,
    label: string,
}

export struct FileRow {
    id: int,
    name: string,
    folder: string,
    size: string,
    fraction: float,
}

/// One row of the scan view's Clean up tab.
export struct CleanRow {
    /// 0 section heading, 1 file or folder, 2 duplicate group label.
    kind: int,
    /// Node to select, for files and folders.
    id: int,
    title: string,
    subtitle: string,
    detail: string,
    /// Button text for headings; empty for none.
    action: string,
    /// A preview, for photos.
    has-image: bool,
    image: image,
}

/// A button of the app sheet.
export struct SheetAction {
    id: string,
    label: string,
    primary: bool,
}

export struct TypeRow {
    /// The extension without the dot; empty for files without one.
    key: string,
    label: string,
    size: string,
    files: string,
    fraction: float,
    color: color,
}

/// One row of the home screen.
export struct HomeRow {
    /// 0 drive or folder, 1 section heading, 2 storage breakdown, 3 app,
    /// 4 notice, 5 app group, 6 storage chart, 7 app bubbles, 8 the header
    /// of a group's page.
    kind: int,
    title: string,
    subtitle: string,
    detail: string,
    fraction: float,
    /// Path for drives, package name for apps, action id for headings,
    /// notices, groups and the page header's button.
    key: string,
    /// Button text for headings and notices; empty for none.
    action: string,
    /// Apps: where it came from and when it was last used. Drives: how
    /// fast they fill up.
    tags: string,
    /// Apps: shown in the warning color (no store can reinstall it).
    /// Drives: full within a month at this rate.
    warn: bool,
    /// Storage breakdown: each part's share of the bar and its legend text.
    apps: float,
    files: float,
    system: float,
    apps-label: string,
    files-label: string,
    system-label: string,
    free-label: string,
    /// Storage chart: SVG paths of the stacked areas in a 1000 × 100 box,
    /// and the dates at either end.
    chart-used: string,
    chart-files: string,
    chart-apps: string,
    chart-start: string,
    chart-end: string,
}

global Theme {
    out property <color> dim: Palette.foreground.transparentize(45%);
    out property <color> apps: #4f8ff7;
    out property <color> files: #34a853;
    out property <color> system: #f4b400;
    out property <color> danger: #d64545;
    out property <color> warn: Palette.color-scheme == ColorScheme.dark ? #f6a35c : #b85c00;
    out property <color> track: Palette.color-scheme == ColorScheme.dark ? #ffffff1f : #0000001a;
    out property <color> rebuild: #2fbf71;
    /// Behind a row while a finger is on it.
    out property <color> pressed: Palette.foreground.transparentize(86%);
}

/// Icons for kinds of content, in the order of `freesize_core::Kind`, then
/// "can be rebuilt" (12) and "more" (13).
global Icons {
    out property <image> folder: @image-url("icons/folder.svg");
    out property <image> file: @image-url("icons/file.svg");
    out property <image> video: @image-url("icons/video.svg");
    out property <image> picture: @image-url("icons/image.svg");
    out property <image> audio: @image-url("icons/audio.svg");
    out property <image> archive: @image-url("icons/archive.svg");
    out property <image> disc: @image-url("icons/disc.svg");
    out property <image> document: @image-url("icons/document.svg");
    out property <image> code: @image-url("icons/code.svg");
    out property <image> program: @image-url("icons/program.svg");
    out property <image> game: @image-url("icons/game.svg");
    out property <image> database: @image-url("icons/database.svg");
    out property <image> rebuild: @image-url("icons/rebuild.svg");
    out property <image> more: @image-url("icons/more.svg");

    public pure function of(kind: int) -> image {
        return kind == 1 ? self.file : kind == 2 ? self.video : kind == 3 ? self.picture : kind == 4 ? self.audio : kind == 5 ? self.archive : kind == 6 ? self.disc : kind == 7 ? self.document : kind == 8 ? self.code : kind == 9 ? self.program : kind == 10 ? self.game : kind == 11 ? self.database : kind == 12 ? self.rebuild : kind == 13 ? self.more : self.folder;
    }
}

component SizeBar inherits Rectangle {
    in property <float> fraction;
    in property <color> fill: Palette.accent-background;
    height: 8px;
    border-radius: 3px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * root.fraction;
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
    }
}

component Chevron inherits Rectangle {
    in property <bool> expanded;
    in property <color> tint;
    width: 16px;
    height: 16px;
    Path {
        width: 9px;
        height: 9px;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: root.expanded ? "M 0 2 L 8 2 L 4 7 Z" : "M 2 0 L 7 4 L 2 8 Z";
        fill: root.tint;
    }
}

component TreePane inherits Rectangle {
    in property <[TreeRow]> rows;
    in property <int> selected-id;
    in property <length> row-height;
    in property <bool> compact;
    in-out property <length> scroll-y;
    callback toggle(int);
    callback select(int);

    list := ListView {
        content-y <=> root.scroll-y;
        for row[index] in root.rows: Rectangle {
            property <bool> selected: row.id == root.selected-id && !row.summary;
            height: root.row-height;
            background: self.selected ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;

            touch := TouchArea {
                clicked => {
                    if (!row.summary) {
                        root.select(row.id);
                    }
                }
                double-clicked => {
                    if (row.expandable) {
                        root.toggle(index);
                    }
                }
            }

            HorizontalLayout {
                padding-left: 4px + row.depth * 14px;
                padding-right: 8px;
                spacing: 6px;
                Rectangle {
                    width: 18px;
                    if row.expandable: Chevron {
                        expanded: row.expanded;
                        tint: selected ? Palette.selection-foreground : Palette.foreground;
                        TouchArea {
                            clicked => {
                                root.toggle(index);
                            }
                        }
                    }
                }

                Text {
                    text: row.name;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                    font-weight: row.is-dir ? 600 : 400;
                    font-italic: row.summary;
                    color: selected ? Palette.selection-foreground : row.summary ? Theme.dim : Palette.foreground;
                }

                if row.note != "": Text {
                    text: row.note;
                    font-size: 11px;
                    vertical-alignment: center;
                    color: Theme.danger;
                }
                Rectangle {
                    width: root.compact ? 44px : 64px;
                    SizeBar {
                        width: 100%;
                        fraction: row.fraction;
                        fill: selected ? Palette.selection-foreground : Palette.accent-background;
                    }
                }

                if !root.compact: Text {
                    text: row.percent;
                    width: 44px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: selected ? Palette.selection-foreground : Theme.dim;
                }

                Text {
                    text: row.size;
                    width: 70px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: selected ? Palette.selection-foreground : Palette.foreground;
                }
            }
        }
    }
}

component TreemapPane inherits Rectangle {
    in property <[MapRect]> rects;
    in property <int> selected-id;
    callback select(int);
    callback resized(length, length);

    clip: true;
    background: Theme.track;

    init => {
        root.resized(self.width, self.height);
    }
    changed width => {
        root.resized(self.width, self.height);
    }
    changed height => {
        root.resized(self.width, self.height);
    }

    for r in root.rects: Rectangle {
        x: r.x;
        y: r.y;
        width: r.width;
        height: r.height;
        background: r.color;
        border-width: r.id == root.selected-id || r.ring ? 2px : 1px;
        border-color: r.id == root.selected-id ? Palette.foreground : r.ring ? Theme.rebuild : r.color.darker(40%);

        if r.icon-size > 0 && !r.nested: Image {
            x: (parent.width - self.width) / 2;
            // Centred, but below a two-line label.
            y: max((parent.height - self.height) / 2 + 7px, r.label != "" ? 34px : 0);
            width: r.icon-size;
            height: r.icon-size;
            source: r.has-app-icon ? r.app-icon : Icons.of(r.icon);
            colorize: r.has-app-icon ? transparent : r.text-color.transparentize(35%);
            image-fit: contain;
        }
        if r.icon-size > 0 && r.nested: Image {
            x: 3px;
            y: 2px;
            width: 12px;
            height: 12px;
            source: r.has-app-icon ? r.app-icon : Icons.of(r.icon);
            colorize: r.has-app-icon ? transparent : r.text-color;
            image-fit: contain;
        }
        if r.label != "": Text {
            x: r.nested && r.icon-size > 0 ? 17px : 4px;
            y: 2px;
            width: parent.width - self.x - 4px;
            height: r.nested ? 14px : parent.height - 4px;
            text: r.label;
            color: r.text-color;
            font-size: 11px;
            overflow: elide;
            wrap: r.nested ? no-wrap : word-wrap;
            vertical-alignment: top;
        }
        TouchArea {
            clicked => {
                root.select(r.id);
            }
        }
    }
}

/// The folder's contents as circles sized by space; tapping one zooms into
/// it (it becomes the shown folder).
component BubblePane inherits Rectangle {
    in property <[BubbleItem]> bubbles;
    in property <int> selected-id;
    callback select(int, string);
    callback resized(length, length);

    clip: true;
    background: Palette.alternate-background;

    init => {
        root.resized(self.width, self.height);
    }
    changed width => {
        root.resized(self.width, self.height);
    }
    changed height => {
        root.resized(self.width, self.height);
    }

    // Circles first, then every label above them; labels don't take taps.
    for b in root.bubbles: Rectangle {
        // Grows in when the view changes.
        property <float> grow: 0;
        init => {
            self.grow = 1;
        }
        animate grow {
            duration: 260ms;
            easing: ease-out;
        }
        x: b.x - b.r * self.grow;
        y: b.y - b.r * self.grow;
        width: b.r * 2 * self.grow;
        height: self.width;
        border-radius: self.width / 2;
        background: b.color;
        border-width: b.id == root.selected-id || b.ring ? 3px : b.depth == 0 ? 1px : 0;
        border-color: b.id == root.selected-id ? Palette.foreground : b.ring ? Theme.rebuild : b.color.darker(25%);
        if b.icon-size > 0 && !b.pill && b.label == "": Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: b.icon-size * parent.grow;
            height: self.width;
            source: b.has-app-icon ? b.app-icon : Icons.of(b.icon);
            colorize: b.has-app-icon ? transparent : b.text-color.transparentize(40%);
            image-fit: contain;
        }
        TouchArea {
            clicked => {
                if (b.id >= 0 || b.key != "") {
                    root.select(b.id, b.key);
                }
            }
        }
    }

    for b in root.bubbles: Rectangle {
        property <float> shown: 0;
        init => {
            self.shown = 1;
        }
        animate shown {
            duration: 400ms;
            easing: ease-in;
        }
        visible: b.label != "";
        opacity: self.shown;
        x: b.x - self.width / 2;
        y: b.y - self.height / 2;
        width: min(b.r * 1.7, max(name.preferred-width, detail.preferred-width, b.icon-size) + 16px);
        height: label.preferred-height + 8px;
        border-radius: 8px;
        background: b.pill ? #000000a0 : transparent;
        label := VerticalLayout {
            padding: 4px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 2px;
            alignment: center;
            if b.icon-size > 0: Image {
                height: b.icon-size;
                width: b.icon-size;
                x: (parent.width - self.width) / 2;
                source: b.has-app-icon ? b.app-icon : Icons.of(b.icon);
                colorize: b.has-app-icon ? transparent : b.pill ? #ffffffd0 : b.text-color.transparentize(25%);
                image-fit: contain;
            }
            name := Text {
                text: b.label;
                horizontal-alignment: center;
                overflow: elide;
                font-size: b.r > 70px ? 13px : 11px;
                font-weight: 600;
                color: b.pill ? #ffffff : b.text-color;
            }

            detail := Text {
                visible: b.detail != "";
                height: b.detail != "" ? self.preferred-height : 0;
                text: b.detail;
                horizontal-alignment: center;
                overflow: elide;
                font-size: 11px;
                color: b.pill ? #ffffffd0 : b.text-color.transparentize(20%);
            }
        }
    }
}

/// Root › … › folder — size. Each step can be tapped to go back to it.
component Breadcrumb inherits HorizontalLayout {
    in property <[Crumb]> crumbs;
    in property <string> size;
    callback select(int);

    height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    spacing: 4px;
    alignment: center;
    for c[i] in root.crumbs: HorizontalLayout {
        spacing: 4px;
        if i > 0: Text {
            text: "›";
            color: Theme.dim;
            vertical-alignment: center;
        }
        Rectangle {
            crumb-text := Text {
                width: 100%;
                height: 100%;
                text: c.label;
                overflow: elide;
                vertical-alignment: center;
                font-weight: i == root.crumbs.length - 1 ? 600 : 400;
                color: i == root.crumbs.length - 1 ? Palette.foreground : crumb-touch.has-hover ? Palette.accent-background : Theme.dim;
            }

            crumb-touch := TouchArea {
                clicked => {
                    root.select(c.id);
                }
            }
        }
    }
    Text {
        text: root.size;
        color: Theme.dim;
        vertical-alignment: center;
    }
}

/// The treemap or the bubbles, with a switch between them.
component MapView inherits Rectangle {
    in property <[MapRect]> rects;
    in property <[BubbleItem]> bubbles;
    in property <int> selected-id;
    in-out property <bool> bubbles-view;
    callback select(int);
    callback map-resized(length, length);
    callback bubbles-resized(length, length);
    callback view-changed();

    if !root.bubbles-view: TreemapPane {
        rects: root.rects;
        selected-id: root.selected-id;
        select(id) => {
            root.select(id);
        }
        resized(w, h) => {
            root.map-resized(w, h);
        }
    }
    if root.bubbles-view: BubblePane {
        bubbles: root.bubbles;
        selected-id: root.selected-id;
        select(id, key) => {
            root.select(id);
        }
        resized(w, h) => {
            root.bubbles-resized(w, h);
        }
    }

    Rectangle {
        x: parent.width - self.width - 8px;
        y: parent.height - self.height - 8px;
        width: switch.preferred-width;
        height: 30px;
        border-radius: 15px;
        background: Palette.background.transparentize(8%);
        border-width: 1px;
        border-color: Palette.border;
        switch := HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            for option[i] in ["Treemap", "Bubbles"]: choice := Rectangle {
                property <bool> on: (i == 1) == root.bubbles-view;
                border-radius: 12px;
                background: self.on ? Palette.accent-background : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: option;
                        font-size: 12px;
                        vertical-alignment: center;
                        color: choice.on ? Palette.accent-foreground : Palette.foreground;
                    }
                }

                TouchArea {
                    clicked => {
                        root.bubbles-view = i == 1;
                        root.view-changed();
                    }
                }
            }
        }
    }
}

component LargestPane inherits Rectangle {
    in property <[FileRow]> files;
    in property <int> selected-id;
    /// Set when only one file type is listed.
    in property <string> filter;
    callback select(int);
    callback clear-filter();
    /// Puts every listed file in the basket.
    callback collect-all();

    VerticalLayout {
        if root.filter != "": Rectangle {
            background: Palette.alternate-background;
            HorizontalLayout {
                padding: 6px;
                padding-left: 10px;
                spacing: 8px;
                Text {
                    text: root.filter;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    font-weight: 600;
                }

                Button {
                    text: "Collect all";
                    clicked => {
                        root.collect-all();
                    }
                }

                Button {
                    text: "Show all";
                    clicked => {
                        root.clear-filter();
                    }
                }
            }
        }
        ListView {
            for file in root.files: Rectangle {
                property <bool> selected: file.id == root.selected-id;
                height: 46px;
                background: self.selected ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;
                touch := TouchArea {
                    clicked => {
                        root.select(file.id);
                    }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: file.name;
                            overflow: elide;
                            color: selected ? Palette.selection-foreground : Palette.foreground;
                        }

                        Text {
                            text: file.folder;
                            overflow: elide;
                            font-size: 11px;
                            color: selected ? Palette.selection-foreground : Theme.dim;
                        }
                    }

                    Rectangle {
                        width: 64px;
                        SizeBar {
                            width: 100%;
                            fraction: file.fraction;
                            fill: selected ? Palette.selection-foreground : Palette.accent-background;
                        }
                    }

                    Text {
                        text: file.size;
                        width: 70px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        color: selected ? Palette.selection-foreground : Palette.foreground;
                    }
                }
            }
        }
    }
}

/// Folders tools rebuild, old large files and duplicates. Selecting a row
/// selects the item in the tree, where the selection bar can delete it.
component CleanupPane inherits Rectangle {
    in property <[CleanRow]> rows;
    in property <int> selected-id;
    callback select(int);
    /// A heading's button; gives the heading's title.
    callback action(string);

    // Sized like the home screen's list; see HomePane.
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(column.preferred-height, end.y + 10px);
        column := VerticalLayout {
            y: 0;
            width: scroll.visible-width;
            height: self.preferred-height * 2 + 1000px;
            alignment: start;
            padding: 10px;
            for row in root.rows: VerticalLayout {
                if row.kind == 0: VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 6px;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: row.title;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }

                        if row.action != "": Button {
                            text: row.action;
                            clicked => {
                                root.action(row.title);
                            }
                        }
                    }

                    if row.subtitle != "": Text {
                        text: row.subtitle;
                        font-size: 12px;
                        color: Theme.dim;
                        wrap: word-wrap;
                    }
                }

                if row.kind == 1: Rectangle {
                    property <bool> selected: row.id == root.selected-id;
                    height: row.has-image ? 64px : 46px;
                    border-radius: 6px;
                    background: self.selected ? Palette.selection-background : touch.has-hover ? Palette.alternate-background : transparent;
                    touch := TouchArea {
                        clicked => {
                            root.select(row.id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        if row.has-image: Rectangle {
                            width: 56px;
                            height: 56px;
                            y: 4px;
                            border-radius: 6px;
                            clip: true;
                            background: Theme.track;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: row.image;
                                image-fit: cover;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: row.title;
                                overflow: elide;
                                color: selected ? Palette.selection-foreground : Palette.foreground;
                            }

                            Text {
                                text: row.subtitle;
                                overflow: elide;
                                font-size: 11px;
                                color: selected ? Palette.selection-foreground : Theme.dim;
                            }
                        }

                        if row.detail != "": Text {
                            text: row.detail;
                            vertical-alignment: center;
                            color: selected ? Palette.selection-foreground : Palette.foreground;
                        }
                    }
                }

                if row.kind == 2: Text {
                    text: row.title;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.dim;
                    height: 26px;
                    vertical-alignment: bottom;
                }
            }

            end := Rectangle {
                height: 0px;
            }
        }
    }
}

/// What changed since an earlier scan, with a picker for which one.
component ChangesPane inherits VerticalLayout {
    in property <[string]> scans;
    in-out property <int> scan-index;
    in property <[CleanRow]> rows;
    in property <int> selected-id;
    callback select(int);
    callback compare(int);

    if root.scans.length > 0: HorizontalLayout {
        padding: 8px;
        padding-bottom: 0;
        spacing: 8px;
        Text {
            text: "Compared with the scan from";
            vertical-alignment: center;
            color: Theme.dim;
        }

        ComboBox {
            model: root.scans;
            current-index <=> root.scan-index;
            horizontal-stretch: 1;
            selected => {
                root.compare(self.current-index);
            }
        }
    }
    CleanupPane {
        rows: root.rows;
        selected-id: root.selected-id;
        select(id) => {
            root.select(id);
        }
    }
}


/// A row of options, one of them chosen.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed();

    width: choices.preferred-width;
    height: 30px;
    border-radius: 15px;
    background: Palette.background.transparentize(8%);
    border-width: 1px;
    border-color: Palette.border;
    choices := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: choice := Rectangle {
            property <bool> on: i == root.current;
            border-radius: 12px;
            background: self.on ? Palette.accent-background : transparent;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: option;
                    font-size: 12px;
                    vertical-alignment: center;
                    color: choice.on ? Palette.accent-foreground : Palette.foreground;
                }
            }

            TouchArea {
                clicked => {
                    root.current = i;
                    root.changed();
                }
            }
        }
    }
}

/// Size by file type, by year changed, or by size. Tapping a row lists its
/// files.
component TypesPane inherits Rectangle {
    in property <[TypeRow]> types;
    in-out property <int> view;
    callback pick(string);
    callback view-changed();

    VerticalLayout {
        HorizontalLayout {
            padding: 6px;
            alignment: start;
            Segmented {
                options: ["Types", "Age", "Size"];
                current <=> root.view;
                changed => {
                    root.view-changed();
                }
            }
        }
        ListView {
            for t in root.types: Rectangle {
                height: 36px;
                background: type-touch.has-hover ? Palette.alternate-background : transparent;
                type-touch := TouchArea {
                    clicked => {
                        root.pick(t.key);
                    }
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Rectangle {
                        width: 12px;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 3px;
                            background: t.color;
                        }
                    }

                    Text {
                        text: t.label;
                        width: 110px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: t.files;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Theme.dim;
                        font-size: 12px;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 80px;
                        SizeBar {
                            width: 100%;
                            fraction: t.fraction;
                            fill: t.color;
                        }
                    }

                    Text {
                        text: t.size;
                        width: 70px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component Legend inherits HorizontalLayout {
    in property <color> swatch;
    in property <string> text;
    spacing: 6px;
    Rectangle {
        width: 10px;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: root.swatch;
        }
    }

    Text {
        text: root.text;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

component Card inherits Rectangle {
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;
}

/// Drives to scan, and on Android how the whole device's storage divides up
/// between apps, files and the system, with every app by size.
component HomePane inherits Rectangle {
    in property <[HomeRow]> rows;
    in-out property <length> scroll-y;
    in property <length> card-height;
    in property <[BubbleItem]> bubbles;
    callback choose(string);
    callback open-app(string);
    callback action(string);
    callback bubble(string);
    callback bubbles-resized(length, length);

    // A plain scrolling layout rather than a ListView: the list view keeps
    // a reused row's old height when its wrapped text changes, so rows would
    // overlap. The home screen has at most a few hundred rows.
    //
    // The scroll height comes from where the empty `end` marker lands, not
    // from the layout's preferred height: Slint measures wrapped text as one
    // line there, which left the last rows out of reach. The layout itself
    // gets room to spare and keeps its rows at the top.
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(column.preferred-height, end.y + 12px);
        content-y <=> root.scroll-y;
        column := VerticalLayout {
            y: 0;
            width: scroll.visible-width;
            height: self.preferred-height * 2 + 1000px;
            alignment: start;
            padding: 16px;
            padding-bottom: 0;
            for row in root.rows: Rectangle {
                content := VerticalLayout {
                    padding-bottom: row.kind == 3 || row.kind == 5 ? 2px : 10px;

                    if row.kind == 0: Card {
                        height: root.card-height + (row.tags != "" ? 16px : 0);
                        background: drive-touch.pressed ? Theme.pressed : drive-touch.has-hover ? Palette.alternate-background : Palette.control-background;
                        drive-touch := TouchArea {
                            clicked => {
                                root.choose(row.key);
                            }
                        }

                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: row.title;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: row.detail;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    color: Theme.dim;
                                    font-size: 12px;
                                }
                            }

                            SizeBar {
                                fraction: row.fraction;
                            }

                            Text {
                                text: row.subtitle;
                                font-size: 11px;
                                color: Theme.dim;
                                overflow: elide;
                            }

                            if row.tags != "": Text {
                                text: row.tags;
                                font-size: 11px;
                                color: row.warn ? Theme.warn : Theme.dim;
                                overflow: elide;
                            }
                        }
                    }

                    if row.kind == 7: VerticalLayout {
                        spacing: 6px;
                        if row.title != "": HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: row.title;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            if row.action != "": Button {
                                text: row.action;
                                clicked => {
                                    root.action(row.key);
                                }
                            }
                        }
                        Text {
                            text: row.subtitle;
                            font-size: 12px;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }

                        BubblePane {
                            height: min(root.width - 32px, 520px);
                            border-radius: 8px;
                            bubbles: root.bubbles;
                            selected-id: -2;
                            select(id, key) => {
                                root.bubble(key);
                            }
                            resized(w, h) => {
                                root.bubbles-resized(w, h);
                            }
                        }
                    }

                    if row.kind == 6: Card {
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: row.title;
                                font-weight: 600;
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: 4px;
                                background: Theme.track;
                                clip: true;
                                Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 1000;
                                    viewbox-height: 100;
                                    commands: row.chart-used;
                                    fill: Theme.system;
                                }

                                Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 1000;
                                    viewbox-height: 100;
                                    commands: row.chart-files;
                                    fill: Theme.files;
                                }

                                Path {
                                    width: 100%;
                                    height: 100%;
                                    viewbox-width: 1000;
                                    viewbox-height: 100;
                                    commands: row.chart-apps;
                                    fill: Theme.apps;
                                }
                            }

                            HorizontalLayout {
                                Text {
                                    text: row.chart-start;
                                    font-size: 11px;
                                    color: Theme.dim;
                                }

                                Text {
                                    text: row.chart-end;
                                    font-size: 11px;
                                    color: Theme.dim;
                                    horizontal-alignment: right;
                                    horizontal-stretch: 1;
                                }
                            }

                            Text {
                                text: row.subtitle;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if row.kind == 1: VerticalLayout {
                        padding-top: 8px;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: row.title;
                                font-size: 18px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }

                            if row.action != "": Button {
                                text: row.action;
                                clicked => {
                                    root.action(row.key);
                                }
                            }
                        }

                        if row.subtitle != "": Text {
                            text: row.subtitle;
                            font-size: 12px;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }
                    }

                    if row.kind == 2: Card {
                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;
                            Text {
                                text: row.title;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                height: 14px;
                                border-radius: 4px;
                                background: Theme.track;
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * row.apps;
                                    background: Theme.apps;
                                }

                                Rectangle {
                                    x: parent.width * row.apps;
                                    width: parent.width * row.files;
                                    background: Theme.files;
                                }

                                Rectangle {
                                    x: parent.width * (row.apps + row.files);
                                    width: parent.width * row.system;
                                    background: Theme.system;
                                }
                            }

                            GridLayout {
                                spacing: 8px;
                                Row {
                                    Legend {
                                        swatch: Theme.apps;
                                        text: row.apps-label;
                                    }

                                    Legend {
                                        swatch: Theme.files;
                                        text: row.files-label;
                                    }
                                }

                                Row {
                                    Legend {
                                        swatch: Theme.system;
                                        text: row.system-label;
                                    }

                                    Legend {
                                        swatch: Theme.track;
                                        text: row.free-label;
                                    }
                                }
                            }

                            if row.subtitle != "": Text {
                                text: row.subtitle;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if row.kind == 3: Rectangle {
                        height: row.tags != "" ? 68px : 56px;
                        border-radius: 6px;
                        background: app-touch.pressed ? Theme.pressed : app-touch.has-hover ? Palette.alternate-background : transparent;
                        app-touch := TouchArea {
                            clicked => {
                                root.open-app(row.key);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: row.title;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: row.subtitle;
                                    font-size: 11px;
                                    color: Theme.dim;
                                    overflow: elide;
                                }

                                if row.tags != "": Text {
                                    text: row.tags;
                                    font-size: 11px;
                                    color: row.warn ? Theme.warn : Theme.dim;
                                    overflow: elide;
                                }
                            }

                            // Removed apps have no size now.
                            if row.detail != "": Rectangle {
                                width: 56px;
                                SizeBar {
                                    width: 100%;
                                    fraction: row.fraction;
                                    fill: Theme.apps;
                                }
                            }

                            if row.detail != "": Text {
                                text: row.detail;
                                width: 72px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if row.kind == 5: Rectangle {
                        height: 48px;
                        border-radius: 6px;
                        background: group-touch.pressed ? Theme.pressed : group-touch.has-hover ? Palette.alternate-background : transparent;
                        group-touch := TouchArea {
                            clicked => {
                                root.action(row.key);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Text {
                                text: row.title;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Text {
                                text: row.detail;
                                font-size: 12px;
                                color: Theme.dim;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "›";
                                color: Theme.dim;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if row.kind == 8: VerticalLayout {
                        spacing: 8px;
                        padding-bottom: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: back-touch.pressed ? Theme.pressed : back-touch.has-hover ? Palette.alternate-background : transparent;
                                back-touch := TouchArea {
                                    clicked => {
                                        // `home::BACK`
                                        root.action("back");
                                    }
                                }

                                // An arrow pointing left.
                                Path {
                                    width: 18px;
                                    height: 18px;
                                    viewbox-width: 18;
                                    viewbox-height: 18;
                                    commands: "M 9 3 L 3 9 L 9 15 M 3 9 L 16 9";
                                    stroke: Palette.foreground;
                                    stroke-width: 2px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: row.title;
                                    font-size: 20px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: row.detail;
                                    font-size: 12px;
                                    color: Theme.dim;
                                }
                            }

                            if row.action != "": VerticalLayout {
                                alignment: center;
                                Button {
                                    text: row.action;
                                    clicked => {
                                        root.action(row.key);
                                    }
                                }
                            }
                        }

                        Text {
                            text: row.subtitle;
                            font-size: 12px;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }
                    }

                    if row.kind == 4: Card {
                        background: Palette.alternate-background;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text {
                                text: row.title;
                                font-weight: 600;
                                wrap: word-wrap;
                            }

                            if row.subtitle != "": Text {
                                text: row.subtitle;
                                font-size: 12px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                            if row.action != "": HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: row.action;
                                    primary: true;
                                    clicked => {
                                        root.action(row.key);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            end := Rectangle {
                height: 0px;
            }
        }
    }
}

component ScanningPane inherits Rectangle {
    in property <string> title;
    in property <string> counts;
    in property <string> current;
    callback cancel();

    VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Spinner {
                indeterminate: true;
                width: 48px;
                height: 48px;
            }
        }

        Text {
            text: root.title;
            font-size: 18px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.counts;
            horizontal-alignment: center;
        }

        Text {
            text: root.current;
            horizontal-alignment: center;
            font-size: 11px;
            color: Theme.dim;
            overflow: elide;
        }

        HorizontalLayout {
            alignment: center;
            Button {
                text: "Cancel";
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "FreeSize";
    icon: @image-url("icon.png");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 320px;
    min-height: 420px;
    background: Palette.background;

    in-out property <string> path;
    in property <bool> scanning;
    in property <bool> has-tree;
    in property <string> status;
    in property <string> scan-title;
    in property <string> scan-counts;
    in property <string> scan-current;
    in property <[HomeRow]> home-rows;
    in property <[TreeRow]> tree-rows;
    in property <[MapRect]> map-rects;
    in property <[FileRow]> largest-files;
    in property <[TypeRow]> file-types;
    in property <[CleanRow]> cleanup-rows;
    in property <[Crumb]> crumbs;
    in property <string> focus-size;
    in property <[BubbleItem]> bubbles;
    in-out property <bool> bubbles-view;
    in property <[BubbleItem]> app-bubbles;
    in property <string> files-filter;
    in property <bool> in-basket;
    in property <int> basket-count;
    in property <string> basket-summary;
    in property <[BasketRow]> basket-rows;
    in property <bool> basket-open;
    /// What the last move was, while it can be put back.
    in property <string> put-back-label;
    /// Places to move the basket to, while choosing one (phones).
    in property <[string]> move-targets;
    /// What the Types tab shows: 0 types, 1 ages, 2 sizes.
    in-out property <int> types-view;
    in property <[string]> change-scans;
    in-out property <int> change-scan-index;
    in property <[CleanRow]> change-rows;
    /// The selected tab of each layout's tabs.
    in-out property <int> wide-tab;
    in-out property <int> compact-tab;
    in property <int> selected-id: -1;
    in property <string> selected-title;
    in property <string> selected-detail;
    in property <bool> can-delete;
    in property <bool> can-go-up;
    in property <bool> can-reveal;
    in property <bool> can-open;
    in property <bool> can-browse;
    in property <string> delete-label: "Move to Trash";
    in property <bool> needs-permission;
    in property <bool> confirm-open;
    in property <string> confirm-text;
    in property <bool> sheet-open;
    in property <string> sheet-title;
    in property <string> sheet-subtitle;
    in property <[string]> sheet-facts;
    in property <string> sheet-note;
    in property <[SheetAction]> sheet-actions;
    // Connecting to a FreeSize Hub.
    in property <bool> hub-connect-open;
    in-out property <string> hub-link;
    in-out property <string> hub-code;
    in property <string> hub-connect-status;
    in property <bool> hub-busy;
    in property <string> hub-confirm-fingerprint;
    // A request from the Hub to approve.
    in property <bool> approval-open;
    in property <string> approval-title;
    in property <[string]> approval-lines;
    in property <[int]> approval-minutes;
    in-out property <bool> size-on-disk: true;
    in-out property <length> tree-scroll;
    /// A group of apps is open as its own page on the home screen.
    in property <bool> home-page-open;
    in-out property <length> home-scroll;

    // Set from `changed width` rather than bound to it: a binding would make
    // the window's size depend on itself through the layout.
    out property <bool> compact;
    out property <length> tree-row-height: root.compact ? 40px : 28px;

    init => {
        root.compact = root.width < 760px;
    }
    changed width => {
        root.compact = root.width < 760px;
    }

    callback start-scan(string);
    callback cancel-scan();
    callback browse();
    callback show-locations();
    callback open-app(string);
    callback home-action(string);
    callback toggle-row(int);
    callback select-node(int, bool);
    callback map-resized(length, length);
    callback bubbles-resized(length, length);
    callback map-view-changed();
    callback app-bubble(string);
    callback type-picked(string);
    callback clear-files-filter();
    callback collect-listed();
    callback collect();
    callback export();
    callback basket-review();
    callback basket-remove(int);
    callback basket-delete-all();
    callback basket-move-all();
    callback basket-clear();
    callback basket-close();
    callback put-back();
    callback move-target(int);
    callback types-view-changed();
    callback compare-scan(int);
    callback app-bubbles-resized(length, length);
    callback size-mode-changed();
    callback go-up();
    callback reveal-selected();
    callback open-selected();
    callback delete-requested();
    callback delete-confirmed();
    callback delete-cancelled();
    callback grant-permission();
    callback sheet-action(string);
    callback cleanup-action(string);
    callback hub-connect();
    callback hub-confirm();
    callback hub-connect-cancel();
    /// -1 to deny, 0 to approve once, else minutes of the grant.
    callback approval-answer(int);
    callback approval-later();

    forward-focus: keys;

    // Android's Back gesture (and Escape on desktop) steps back through the
    // app before leaving it: close the dialog, stop the scan, zoom out, then
    // return to the drive list, or from a group's page to the home screen.
    // Unhandled, Back closes the app.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text != Key.Back && event.text != Key.Escape) {
                return reject;
            }
            if (root.approval-open) {
                root.approval-later();
                return accept;
            }
            if (root.hub-connect-open) {
                root.hub-connect-cancel();
                return accept;
            }
            if (root.sheet-open) {
                root.sheet-action("close");
                return accept;
            }
            if (root.basket-open) {
                root.basket-close();
                return accept;
            }
            if (root.confirm-open) {
                root.delete-cancelled();
                return accept;
            }
            if (root.scanning) {
                root.cancel-scan();
                return accept;
            }
            if (root.has-tree && root.can-go-up) {
                root.go-up();
                return accept;
            }
            if (root.has-tree && event.text == Key.Back) {
                root.show-locations();
                return accept;
            }
            if (!root.has-tree && root.home-page-open) {
                // `home::BACK`
                root.home-action("back");
                return accept;
            }
            reject
        }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            // Toolbar
            Rectangle {
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 8px;
                    padding-top: 8px + root.safe-area-insets.top;
                    spacing: 6px;
                    if root.has-tree && !root.scanning: Button {
                        text: "Drives";
                        clicked => {
                            root.show-locations();
                        }
                    }
                    LineEdit {
                        text <=> root.path;
                        placeholder-text: "Folder to scan";
                        horizontal-stretch: 1;
                        enabled: !root.scanning;
                        accepted(text) => {
                            root.start-scan(text);
                        }
                    }

                    if root.can-browse: Button {
                        text: "Browse…";
                        enabled: !root.scanning;
                        clicked => {
                            root.browse();
                        }
                    }
                    Button {
                        text: root.scanning ? "Cancel" : "Scan";
                        primary: !root.scanning;
                        clicked => {
                            if (root.scanning) {
                                root.cancel-scan();
                            } else {
                                root.start-scan(root.path);
                            }
                        }
                    }
                }
            }

            // Android storage permission
            if root.needs-permission: Rectangle {
                background: #f0b42933;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;
                    Text {
                        text: "FreeSize needs “All files access” to see everything on your storage.";
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Grant access";
                        primary: true;
                        clicked => {
                            root.grant-permission();
                        }
                    }
                }
            }

            // Status line
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 8px;
                Text {
                    text: root.status;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    color: Theme.dim;
                    font-size: 12px;
                }

                if root.has-tree: Button {
                    text: "Export";
                    clicked => {
                        root.export();
                    }
                }
                if root.has-tree: ComboBox {
                    width: 150px;
                    model: ["Size on disk", "File size"];
                    current-index: 0;
                    selected => {
                        root.size-on-disk = self.current-index == 0;
                        root.size-mode-changed();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // Content
            if root.scanning: ScanningPane {
                vertical-stretch: 1;
                title: root.scan-title;
                counts: root.scan-counts;
                current: root.scan-current;
                cancel => {
                    root.cancel-scan();
                }
            }
            if !root.scanning && !root.has-tree: HomePane {
                vertical-stretch: 1;
                rows: root.home-rows;
                scroll-y <=> root.home-scroll;
                card-height: root.compact ? 86px : 78px;
                bubbles: root.app-bubbles;
                bubble(key) => {
                    root.app-bubble(key);
                }
                bubbles-resized(w, h) => {
                    root.app-bubbles-resized(w, h);
                }
                choose(path) => {
                    root.path = path;
                    root.start-scan(path);
                }
                open-app(package) => {
                    root.open-app(package);
                }
                action(id) => {
                    root.home-action(id);
                }
            }
            if !root.scanning && root.has-tree && !root.compact: HorizontalLayout {
                vertical-stretch: 1;
                TreePane {
                    horizontal-stretch: 45;
                    rows: root.tree-rows;
                    selected-id: root.selected-id;
                    row-height: root.tree-row-height;
                    compact: root.compact;
                    scroll-y <=> root.tree-scroll;
                    toggle(index) => {
                        root.toggle-row(index);
                    }
                    select(id) => {
                        root.select-node(id, false);
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Palette.border;
                }

                VerticalLayout {
                    horizontal-stretch: 55;
                    Breadcrumb {
                        crumbs: root.crumbs;
                        size: root.focus-size;
                        select(id) => {
                            root.select-node(id, true);
                        }
                    }

                    TabWidget {
                        current-index <=> root.wide-tab;
                        Tab {
                            title: "Map";
                            MapView {
                                rects: root.map-rects;
                                bubbles: root.bubbles;
                                selected-id: root.selected-id;
                                bubbles-view <=> root.bubbles-view;
                                select(id) => {
                                    root.select-node(id, true);
                                }
                                map-resized(w, h) => {
                                    root.map-resized(w, h);
                                }
                                bubbles-resized(w, h) => {
                                    root.bubbles-resized(w, h);
                                }
                                view-changed => {
                                    root.map-view-changed();
                                }
                            }
                        }

                        Tab {
                            title: "Largest files";
                            LargestPane {
                                files: root.largest-files;
                                selected-id: root.selected-id;
                                filter: root.files-filter;
                                select(id) => {
                                    root.select-node(id, true);
                                }
                                clear-filter => {
                                    root.clear-files-filter();
                                }
                                collect-all => {
                                    root.collect-listed();
                                }
                            }
                        }

                        Tab {
                            title: "File types";
                            TypesPane {
                                types: root.file-types;
                                view <=> root.types-view;
                                pick(key) => {
                                    root.type-picked(key);
                                }
                                view-changed => {
                                    root.types-view-changed();
                                }
                            }
                        }

                        Tab {
                            title: "Clean up";
                            CleanupPane {
                                rows: root.cleanup-rows;
                                selected-id: root.selected-id;
                                select(id) => {
                                    root.select-node(id, true);
                                }
                                action(title) => {
                                    root.cleanup-action(title);
                                }
                            }
                        }

                        Tab {
                            title: "Changes";
                            ChangesPane {
                                scans: root.change-scans;
                                scan-index <=> root.change-scan-index;
                                rows: root.change-rows;
                                selected-id: root.selected-id;
                                select(id) => {
                                    root.select-node(id, true);
                                }
                                compare(index) => {
                                    root.compare-scan(index);
                                }
                            }
                        }
                    }
                }
            }
            if !root.scanning && root.has-tree && root.compact: TabWidget {
                vertical-stretch: 1;
                current-index <=> root.compact-tab;
                Tab {
                    title: "Folders";
                    TreePane {
                        rows: root.tree-rows;
                        selected-id: root.selected-id;
                        row-height: root.tree-row-height;
                        compact: root.compact;
                        scroll-y <=> root.tree-scroll;
                        toggle(index) => {
                            root.toggle-row(index);
                        }
                        select(id) => {
                            root.select-node(id, false);
                        }
                    }
                }

                Tab {
                    title: "Map";
                    VerticalLayout {
                        Breadcrumb {
                            crumbs: root.crumbs;
                            size: root.focus-size;
                            select(id) => {
                                root.select-node(id, false);
                            }
                        }

                        MapView {
                            rects: root.map-rects;
                            bubbles: root.bubbles;
                            selected-id: root.selected-id;
                            bubbles-view <=> root.bubbles-view;
                            select(id) => {
                                root.select-node(id, false);
                            }
                            map-resized(w, h) => {
                                root.map-resized(w, h);
                            }
                            bubbles-resized(w, h) => {
                                root.bubbles-resized(w, h);
                            }
                            view-changed => {
                                root.map-view-changed();
                            }
                        }
                    }
                }

                Tab {
                    title: "Files";
                    LargestPane {
                        files: root.largest-files;
                        selected-id: root.selected-id;
                        filter: root.files-filter;
                        select(id) => {
                            root.select-node(id, true);
                        }
                        clear-filter => {
                            root.clear-files-filter();
                        }
                        collect-all => {
                            root.collect-listed();
                        }
                    }
                }

                Tab {
                    title: "Types";
                    TypesPane {
                        types: root.file-types;
                        view <=> root.types-view;
                        pick(key) => {
                            root.type-picked(key);
                        }
                        view-changed => {
                            root.types-view-changed();
                        }
                    }
                }

                Tab {
                    title: "Clean";
                    CleanupPane {
                        rows: root.cleanup-rows;
                        selected-id: root.selected-id;
                        select(id) => {
                            root.select-node(id, true);
                        }
                        action(title) => {
                            root.cleanup-action(title);
                        }
                    }
                }

                Tab {
                    title: "Changes";
                    ChangesPane {
                        scans: root.change-scans;
                        scan-index <=> root.change-scan-index;
                        rows: root.change-rows;
                        selected-id: root.selected-id;
                        select(id) => {
                            root.select-node(id, true);
                        }
                        compare(index) => {
                            root.compare-scan(index);
                        }
                    }
                }
            }

            // Basket bar: what's collected, and the last move to put back.
            if !root.scanning && root.has-tree && (root.basket-count > 0 || root.put-back-label != ""): Rectangle {
                background: Palette.accent-background.transparentize(85%);
                HorizontalLayout {
                    padding: 6px;
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: root.basket-count > 0 ? "Basket: " + root.basket-summary : "Moved: " + root.put-back-label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    if root.basket-count > 0: Button {
                        text: "Review";
                        primary: true;
                        clicked => {
                            root.basket-review();
                        }
                    }
                    if root.basket-count == 0: Button {
                        text: "Put back";
                        clicked => {
                            root.put-back();
                        }
                    }
                }
            }

            // Selection bar
            if !root.scanning && root.has-tree: Rectangle {
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 8px;
                    padding-bottom: 8px + root.safe-area-insets.bottom;
                    spacing: 6px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.selected-title;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: root.selected-detail;
                            font-size: 11px;
                            color: Theme.dim;
                            overflow: elide;
                        }
                    }

                    Button {
                        text: "Up";
                        enabled: root.can-go-up;
                        clicked => {
                            root.go-up();
                        }
                    }

                    Button {
                        text: "Open";
                        enabled: root.can-open;
                        clicked => {
                            root.open-selected();
                        }
                    }

                    if root.can-reveal && !root.compact: Button {
                        text: "Show in folder";
                        clicked => {
                            root.reveal-selected();
                        }
                    }
                    Button {
                        text: root.in-basket ? "Collected" : "Collect";
                        enabled: root.can-delete || root.in-basket;
                        clicked => {
                            root.collect();
                        }
                    }

                    Button {
                        text: "Delete";
                        enabled: root.can-delete;
                        clicked => {
                            root.delete-requested();
                        }
                    }
                }
            }

            // Keep content above the gesture bar when there is no selection bar.
            if root.scanning || !root.has-tree: Rectangle {
                height: root.safe-area-insets.bottom;
            }
        }
    }

    // Delete confirmation
    if root.confirm-open: Rectangle {
        background: #00000088;
        TouchArea { }

        Rectangle {
            width: min(420px, parent.width - 32px);
            height: dialog.preferred-height;
            border-radius: 10px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            dialog := VerticalLayout {
                padding: 18px;
                spacing: 16px;
                Text {
                    text: root.confirm-text;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.delete-cancelled();
                        }
                    }

                    Button {
                        text: root.delete-label;
                        primary: true;
                        clicked => {
                            root.delete-confirmed();
                        }
                    }
                }
            }
        }
    }

    // The basket: everything collected, to delete or move at once. A bottom
    // sheet on phones, a centered dialog on wide windows.
    if root.basket-open: Rectangle {
        background: #00000088;
        TouchArea {
            clicked => {
                root.basket-close();
            }
        }

        Rectangle {
            width: root.compact ? parent.width : min(520px, parent.width - 32px);
            height: min(basket-layout.preferred-height, parent.height - root.safe-area-insets.top - 24px);
            y: root.compact ? parent.height - self.height : (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            TouchArea { }

            basket-layout := VerticalLayout {
                padding: 18px;
                padding-bottom: 18px + (root.compact ? root.safe-area-insets.bottom : 0px);
                spacing: 8px;
                Text {
                    text: "Basket";
                    font-size: 18px;
                    font-weight: 600;
                }

                Text {
                    text: root.basket-count > 0 ? root.basket-summary : "Empty.";
                    color: Theme.dim;
                    wrap: word-wrap;
                }

                if root.basket-count > 0: ListView {
                    height: min(root.basket-rows.length * 46px, 276px);
                    for row in root.basket-rows: Rectangle {
                        height: 46px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: row.name;
                                    overflow: elide;
                                }

                                Text {
                                    text: row.place;
                                    font-size: 11px;
                                    color: Theme.dim;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: row.size;
                                vertical-alignment: center;
                            }

                            Button {
                                text: "Remove";
                                clicked => {
                                    root.basket-remove(row.id);
                                }
                            }
                        }
                    }
                }
                if root.move-targets.length > 0: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Move everything to:";
                        font-weight: 600;
                    }

                    for target[i] in root.move-targets: Button {
                        text: target;
                        clicked => {
                            root.move-target(i);
                        }
                    }
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.basket-close();
                        }
                    }
                }
                if root.move-targets.length == 0: VerticalLayout {
                    spacing: 6px;
                    padding-top: 6px;
                    Button {
                        text: "Delete all";
                        primary: true;
                        enabled: root.basket-count > 0;
                        clicked => {
                            root.basket-delete-all();
                        }
                    }

                    Button {
                        text: "Move all…";
                        enabled: root.basket-count > 0;
                        clicked => {
                            root.basket-move-all();
                        }
                    }

                    if root.put-back-label != "": Button {
                        text: "Put back: " + root.put-back-label;
                        clicked => {
                            root.put-back();
                        }
                    }
                    Button {
                        text: "Empty basket";
                        enabled: root.basket-count > 0;
                        clicked => {
                            root.basket-clear();
                        }
                    }

                    Button {
                        text: "Close";
                        clicked => {
                            root.basket-close();
                        }
                    }
                }
            }
        }
    }

    // App details: facts and actions for one app. A bottom sheet on phones,
    // a centered dialog on wide windows.
    if root.sheet-open: Rectangle {
        background: #00000088;
        TouchArea {
            clicked => {
                root.sheet-action("close");
            }
        }

        Rectangle {
            width: root.compact ? parent.width : min(480px, parent.width - 32px);
            height: min(sheet-layout.preferred-height, parent.height - root.safe-area-insets.top - 24px);
            y: root.compact ? parent.height - self.height : (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            // Keeps taps on the sheet from closing it.
            TouchArea { }

            Flickable {
                content-width: self.width;
                content-height: sheet-layout.preferred-height;
                sheet-layout := VerticalLayout {
                    width: parent.width;
                    padding: 18px;
                    padding-bottom: 18px + (root.compact ? root.safe-area-insets.bottom : 0px);
                    spacing: 6px;
                    Text {
                        text: root.sheet-title;
                        font-size: 18px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.sheet-subtitle;
                        font-size: 12px;
                        color: Theme.dim;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 4px;
                    }

                    for fact in root.sheet-facts: Text {
                        text: fact;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    if root.sheet-note != "": Rectangle {
                        border-radius: 6px;
                        background: Theme.system.transparentize(80%);
                        height: note.preferred-height;
                        note := VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.sheet-note;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: 6px;
                    }

                    for action in root.sheet-actions: Button {
                        text: action.label;
                        primary: action.primary;
                        clicked => {
                            root.sheet-action(action.id);
                        }
                    }
                }
            }
        }
    }

    // Connecting to a FreeSize Hub: a pairing link, or its address and code.
    if root.hub-connect-open: Rectangle {
        background: #00000088;
        TouchArea { }

        Rectangle {
            width: root.compact ? parent.width : min(480px, parent.width - 32px);
            height: min(connect-layout.preferred-height, parent.height - root.safe-area-insets.top - 24px);
            y: root.compact ? parent.height - self.height : (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            connect-layout := VerticalLayout {
                padding: 18px;
                padding-bottom: 18px + (root.compact ? root.safe-area-insets.bottom : 0px);
                spacing: 10px;
                Text {
                    text: "Connect to a FreeSize Hub";
                    font-size: 18px;
                    font-weight: 600;
                }

                Text {
                    text: "In the Hub's dashboard, choose Pair a device. Paste the link it shows, or type the Hub's address and the code.";
                    font-size: 13px;
                    wrap: word-wrap;
                }

                LineEdit {
                    text <=> root.hub-link;
                    placeholder-text: "Pairing link, or the Hub's address";
                    enabled: !root.hub-busy && root.hub-confirm-fingerprint == "";
                }

                LineEdit {
                    text <=> root.hub-code;
                    placeholder-text: "Code, when typing the address";
                    enabled: !root.hub-busy && root.hub-confirm-fingerprint == "";
                }

                if root.hub-confirm-fingerprint != "": Rectangle {
                    border-radius: 6px;
                    background: Theme.system.transparentize(80%);
                    height: fingerprint-layout.preferred-height;
                    fingerprint-layout := VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Text {
                            text: "This Hub's key is";
                            font-size: 13px;
                        }

                        Text {
                            text: root.hub-confirm-fingerprint;
                            font-size: 17px;
                            font-weight: 700;
                        }

                        Text {
                            text: "Check it matches the dashboard (Settings → This Hub) before connecting.";
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.hub-connect-status != "": Text {
                    text: root.hub-connect-status;
                    font-size: 13px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => {
                            root.hub-connect-cancel();
                        }
                    }

                    Button {
                        text: root.hub-confirm-fingerprint != "" ? "It matches, connect" : "Connect";
                        primary: true;
                        enabled: !root.hub-busy;
                        clicked => {
                            if (root.hub-confirm-fingerprint != "") {
                                root.hub-confirm();
                            } else {
                                root.hub-connect();
                            }
                        }
                    }
                }
            }
        }
    }

    // A request from the Hub: shown in full, nothing happens until it's
    // approved here.
    if root.approval-open: Rectangle {
        background: #00000088;
        TouchArea { }

        Rectangle {
            width: root.compact ? parent.width : min(500px, parent.width - 32px);
            height: min(approval-layout.preferred-height, parent.height - root.safe-area-insets.top - 24px);
            y: root.compact ? parent.height - self.height : (parent.height - self.height) / 2;
            border-radius: 12px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            clip: true;
            approval-layout := VerticalLayout {
                padding: 18px;
                padding-bottom: 18px + (root.compact ? root.safe-area-insets.bottom : 0px);
                spacing: 8px;
                Text {
                    text: root.approval-title;
                    font-size: 18px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Rectangle {
                    border-radius: 6px;
                    background: Palette.alternate-background;
                    height: min(lines-layout.preferred-height, 260px);
                    Flickable {
                        content-height: lines-layout.preferred-height;
                        lines-layout := VerticalLayout {
                            padding: 10px;
                            spacing: 3px;
                            for line[i] in root.approval-lines: Text {
                                text: line;
                                font-size: i == 0 ? 14px : 12px;
                                font-weight: i == 0 ? 600 : 400;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Text {
                    text: "Nothing happens unless you approve. A grant lets the same person do the same kind of thing again without asking, until it runs out.";
                    font-size: 12px;
                    color: Theme.dim;
                    wrap: word-wrap;
                }

                Button {
                    text: "Approve once";
                    primary: true;
                    clicked => {
                        root.approval-answer(0);
                    }
                }

                for minutes in root.approval-minutes: Button {
                    text: "Approve for " + minutes + " minutes";
                    clicked => {
                        root.approval-answer(minutes);
                    }
                }

                Button {
                    text: "Deny";
                    clicked => {
                        root.approval-answer(-1);
                    }
                }

                Button {
                    text: "Not now";
                    clicked => {
                        root.approval-later();
                    }
                }
            }
        }
    }
}
