<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Shown until Slint draws its first frame, so it matches the UI's background
    to avoid a flash. The app draws edge to edge and pads itself with Slint's
    safe-area insets; dark system bar icons suit the light UI.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
