<?xml version='1.0' standalone='yes'?>
<!-- The last DiskTree plugin: DiskTree is called FreeSize since 0.8.6.
     Servers with DiskTree 0.8.5 or older look for updates here (their
     pluginURL), so this update installs freesize.plg, which takes over
     DiskTree's settings, Hub pairing and quarantine and removes DiskTree.
     scripts/unraid-plugin.sh fills in the version. -->
<!DOCTYPE PLUGIN [
<!ENTITY name       "disktree">
<!ENTITY author     "McGeaverBeaver">
<!ENTITY version    "@VERSION@">
<!ENTITY repo       "https://github.com/McGeaverBeaver/FreeSize">
<!ENTITY pluginURL  "&repo;/releases/latest/download/disktree.plg">
<!ENTITY freesize   "&repo;/releases/download/v&version;/freesize.plg">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" support="&repo;/issues" icon="pie-chart" min="6.12.0">

<CHANGES>
### @VERSION@
- DiskTree is called FreeSize now. This update installs FreeSize, which keeps DiskTree's settings, Hub pairing and quarantine, and then removes DiskTree.
</CHANGES>

<!-- Unraid records this file as the installed plugin once the update
     ends, so FreeSize is installed after that, in the background; it
     removes this plugin as it takes over. -->
<FILE Run="/bin/bash">
<INLINE>
setsid nohup bash -c 'sleep 30; /usr/local/sbin/plugin install "&freesize;"' \
  &gt;/var/log/disktree-to-freesize.log 2&gt;&amp;1 &lt;/dev/null &amp;
echo
echo "FreeSize installs itself in place of DiskTree within a minute, keeping"
echo "the settings, Hub pairing and quarantine. Then open Tools, FreeSize."
echo "If it doesn't appear, see /var/log/disktree-to-freesize.log, or install"
echo "&freesize; from Plugins, Install Plugin."
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
[ -x /etc/rc.d/rc.disktree ] &amp;&amp; /etc/rc.d/rc.disktree stop
for p in /var/log/packages/disktree-*; do
  [ -e "$p" ] &amp;&amp; removepkg "${p##*/}" &gt;/dev/null
done
rm -rf /usr/local/emhttp/plugins/disktree /var/local/disktree
echo "DiskTree is removed. FreeSize, if installed, isn't touched."
</INLINE>
</FILE>

</PLUGIN>
