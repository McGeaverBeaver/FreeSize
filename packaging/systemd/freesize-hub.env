# Settings for freesize-hub.service. Keep this file readable by root only
# (chmod 600): it holds the sign-in client secret.

# Address and port to listen on. A LAN or WireGuard address keeps the Hub
# off the internet; 0.0.0.0 listens everywhere.
FREESIZE_HUB_LISTEN=192.168.10.200:9090

# How people and devices reach the Hub; the Hub makes its certificate for
# this host. Authentik's redirect URI is this plus /auth/callback.
FREESIZE_HUB_URL=https://freesize.home.lan
FREESIZE_HUB_NAME=FreeSize Hub

# HTTPS: auto (the Hub's own certificate, renewed by itself; the dashboard's
# Settings offers the authority to install in a browser) or off (plain http,
# for a reverse proxy that does HTTPS in front). Your own certificate (PEM,
# with its chain) and key replace the Hub's own and are reloaded when the
# files change.
FREESIZE_TLS=auto
#FREESIZE_TLS_CERT_FILE=/etc/ssl/freesize-hub/fullchain.pem
#FREESIZE_TLS_KEY_FILE=/etc/ssl/freesize-hub/privkey.pem

# The Authentik provider: issuer, client ID and secret.
FREESIZE_OIDC_ISSUER=https://auth.home.lan/application/o/freesize/
FREESIZE_OIDC_CLIENT_ID=
FREESIZE_OIDC_CLIENT_SECRET=

# Authentik groups for admins and for people who may only look.
FREESIZE_ADMIN_GROUP=freesize-admins
FREESIZE_VIEWER_GROUP=freesize-viewers

# Optional: turns on /metrics (Prometheus) and /metrics/json, for requests
# with "Authorization: Bearer <token>".
#FREESIZE_METRICS_TOKEN=
