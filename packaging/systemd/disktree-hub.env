# Settings for disktree-hub.service. Keep this file readable by root only
# (chmod 600): it holds the sign-in client secret.

# Address and port to listen on. A LAN or WireGuard address keeps the Hub
# off the internet; 0.0.0.0 listens everywhere.
DISKTREE_HUB_LISTEN=192.168.10.200:9090

# How people and devices reach the Hub (behind a reverse proxy, its HTTPS
# address). Authentik's redirect URI is this plus /auth/callback.
DISKTREE_HUB_URL=https://disktree.home.lan
DISKTREE_HUB_NAME=DiskTree Hub

# The Authentik provider: issuer, client ID and secret.
DISKTREE_OIDC_ISSUER=https://auth.home.lan/application/o/disktree/
DISKTREE_OIDC_CLIENT_ID=
DISKTREE_OIDC_CLIENT_SECRET=

# Authentik groups for admins and for people who may only look.
DISKTREE_ADMIN_GROUP=disktree-admins
DISKTREE_VIEWER_GROUP=disktree-viewers

# Optional: turns on /metrics (Prometheus) and /metrics/json, for requests
# with "Authorization: Bearer <token>".
#DISKTREE_METRICS_TOKEN=
